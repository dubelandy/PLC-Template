<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AnalogInputControl" Id="{32367d4c-3811-44e9-afe8-a4a3a1943462}">
    <Declaration><![CDATA[TYPE ST_AnalogInputControl :
STRUCT
	sim					: BOOL; //use simValue instead of the physical input
	simValue			: LREAL; //simulated value in engineering units (written by HMI or test tools)
	reset				: BOOL; //reset latched alarms and faults (cleared by the FB)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>