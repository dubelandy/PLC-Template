<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_VFD" Id="{00e422ce-f8db-4bbc-b80c-5438860bd0ad}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'}
FUNCTION_BLOCK FB_VFD EXTENDS FB_Device
VAR_INPUT
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	cfg 				: ST_VFDConfiguration; //configuration
	
	{attribute 'OPC.UA.DA' := '1'}
	ocmd 				: E_VFDCommand; //operator command
	
	func				: ST_VFDFunctions; //functions
	
	cmdQuickStop 		: BOOL; //use a quick stop instead of a freewheel stop (cleared every scan)
	
	(* Interlocks/Permissives
	----------------------------------------------------------------------------------------------------*)
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	fwdIntlk			: FB_Permissive; //Interlocks to stop/prevent forward motion
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	fwdPerm				: FB_Permissive; //Permissives to start forward motion
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	revIntlk			: FB_Permissive; //Interlocks to stop/prevent reverse motion
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	revPerm				: FB_Permissive; //Permissives to start reverse motion
	
	(* External inputs
	----------------------------------------------------------------------------------------------------*)
	inStatusWord 	AT %I* 	: WORD; //drive status word
	inControlEffort	AT %I* 	: WORD; //drive control effort
END_VAR
VAR_OUTPUT
	outControlWord 		AT %Q* : WORD; //drive control word
	outTargetVelocity  	AT %Q* : WORD; //drive target velocity
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	sts					: ST_VFDStatus; //status
END_VAR
VAR
	// Command vars
	pcmd			: E_VFDCommand; //program command
	pcmdLast		: E_VFDCommand;
	ocmdLast		: E_VFDCommand;	
	activeCommand	: E_VFDCommand;
	activeCmdLast	: E_VFDCommand;
	
	// State vars
	stCommands		: ST_VFDCommand;
	maskState		: WORD := LOWEST_8_BITS;
	arrNotReady		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	arrRunning		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	arrReady		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	
	// Debugging 
	statusWord_CiA402 : ST_CiA402StatusWord;
	
	// General
	firstEnable		: BOOL;
END_VAR
VAR CONSTANT
	LOWEST_4_BITS	: WORD := 2#000000001111;
	LOWEST_8_BITS	: WORD := 2#000011111111;
	LOWEST_12_BITS	: WORD := 2#111111111111;
	MAX_ARR_LENGTH	: INT  := 10;
	
	// Constants specific to the CiA402 functional profile
	FAULTED_BIT			: INT := 3;
	DISABLED_BIT		: INT := 6;
	TARGET_REACHED_BIT	: INT := 10;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();

Device();
MapInputs();
ProcessCommands();
StateMachine();
Status();
MapOutputs();
Functions();]]></ST>
    </Implementation>
    <Folder Name="Private" Id="{44fd08e9-d899-4c95-a515-04ca352c365b}" />
    <Folder Name="Public" Id="{30bc1ae0-0246-4d7f-b737-8548d4619875}">
      <Folder Name="Commands" Id="{6c489fb8-005a-46b1-bbe4-8eac95352879}" />
      <Folder Name="Control" Id="{43bc9fdb-badb-4154-acd7-f2510a8c1275}" />
    </Folder>
    <Method Name="Enable" Id="{2b2d9be6-c335-419b-be70-bb50b0a148e2}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Enable : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_VFDCommand.Enable;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Functions" Id="{206b50c6-c011-4fe9-b095-e4244356b6e4}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED Functions : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[func.Enable		(hmiTextStatic := CONCAT(cfg.motorId, ' enable drive'));
func.LatchJogFwd(hmiTextStatic := CONCAT(cfg.motorId, ' latch jog forward'));
func.LatchJogRev(hmiTextStatic := CONCAT(cfg.motorId, ' latch jog reverse'));
func.Stop		(hmiTextStatic := CONCAT(cfg.motorId, ' stop'));

IF func.Enable.running THEN
	Enable();
	func.Enable.permComplete.perm.0 := sts.enabled OR sts.sim;
END_IF

IF func.LatchJogFwd.running THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.LatchJogFwd.arrParam[i].typeEnum OF
			E_VFDFunctionParam.JogSpeed:
				cfg.targetVelocity := LREAL_TO_WORD(func.LatchJogFwd.arrParam[i].value);
		END_CASE
	END_FOR
	LatchJogFwd();
	func.LatchJogFwd.permComplete.perm.0 := sts.state_running OR sts.sim;
END_IF

IF func.LatchJogRev.running THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.LatchJogRev.arrParam[i].typeEnum OF
			E_VFDFunctionParam.JogSpeed:
				cfg.targetVelocity := LREAL_TO_WORD(func.LatchJogRev.arrParam[i].value);
		END_CASE
	END_FOR
	LatchJogRev();
	func.LatchJogRev.permComplete.perm.0 := sts.state_running OR sts.sim;
END_IF

IF func.Stop.running THEN
	Stop();
	func.Stop.permComplete.perm.0 := NOT sts.state_running;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogFwd" Id="{b2536360-bc1b-47ea-a8ea-fe85cd718966}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC JogFwd : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_VFDCommand.JogFwd;]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogRev" Id="{28eef5ec-5ba6-4aa5-ae7d-3134d552717c}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC JogRev : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_VFDCommand.JogRev;]]></ST>
