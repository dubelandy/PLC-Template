    </Method>
    <Method Name="LatchJogFwd" Id="{675ed1b8-5fa8-4c5e-b9e5-16fb6d984d50}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC LatchJogFwd : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_VFDCommand.LatchJogFwd;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LatchJogRev" Id="{d5e57718-2eee-430e-9fed-6d4a18c7e7f5}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC LatchJogRev : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
