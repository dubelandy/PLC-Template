<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_SequencerFunctionState" Id="{ce17cc6e-908c-48c5-bf31-fa88c301a606}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_SequencerFunctionState :
(
	Idle		:= 0, //never started or reset
	Running		:= 1, //waiting for permComplete
	Complete	:= 2, //permComplete was satisfied
	Error		:= 3, //device reported an error or the function timed out
	Aborted		:= 4 //aborted before completing
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>