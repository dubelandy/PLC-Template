    </LineIds>
    <LineIds Name="FB_Permissive.DisableBypass">
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_Permissive.EnableBypass">
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_Permissive.GetPermText">
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_Permissive.Reset">
      <LineId Id="6" Count="0" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>