<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ExampleSoftwareSimConfiguration" Id="{a0e0b118-8004-44ba-9992-191cd8af5c9b}">
    <Declaration><![CDATA[TYPE ST_ExampleSoftwareSimConfiguration :
STRUCT
	enable				: BOOL := TRUE; //answer the station's transactions
	responseDelay		: TIME := T#500MS; //delay before each software action
	closeDwell			: TIME := T#1S; //closeDwell sent in each request
	
	//Fault injection
	freeze				: BOOL; //stop responding where it is (tests the commTimeout)
	sendInvalidRequest	: BOOL; //send closeDwell = T#0S (station should reject it)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>