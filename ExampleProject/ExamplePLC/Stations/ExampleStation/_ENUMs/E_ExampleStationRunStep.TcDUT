<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_ExampleStationRunStep" Id="{a93898bd-8d3a-42ae-bdd2-e0868e69913a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ExampleStationRunStep :
(
	Idle			:= 0, //not running
	RequestJob		:= 10, //raise attention, ask the software for a job
	WaitJob			:= 20, //wait for the request, validate it, ack or reject
	WaitWorking		:= 30, //wait for the software to drop trigger
	Close			:= 40, //closing both actuators
	HoldClosed		:= 50, //holding closed for the requested closeDwell
	Open			:= 60, //opening both actuators
	Report			:= 70, //send the response with tell
	WaitReportAck	:= 80, //wait for the software to acknowledge the response
	Dwell			:= 90 //wait before requesting the next job
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>