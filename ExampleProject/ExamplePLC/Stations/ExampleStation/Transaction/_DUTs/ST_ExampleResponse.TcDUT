<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ExampleResponse" Id="{83676afa-2fd5-4509-a012-146468979d42}">
    <Declaration><![CDATA[(* Response from the station to the software, sent with tell. *)
TYPE ST_ExampleResponse :
STRUCT
	cycleId				: UDINT; //cycleId from the request
	cycleTime			: TIME; //time to close, hold and open
	ok					: BOOL; //cycle completed without faults
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>