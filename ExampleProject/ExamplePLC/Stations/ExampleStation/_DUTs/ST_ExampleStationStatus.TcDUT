<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ExampleStationStatus" Id="{bf60c8ff-6c3e-41e1-8b16-b6c19490999a}">
    <Declaration><![CDATA[TYPE ST_ExampleStationStatus :
STRUCT
	runStep				: E_ExampleStationRunStep := E_ExampleStationRunStep.Idle; //running sequence step
	allOpen				: BOOL; //both actuators at home (open)
	allClosed			: BOOL; //both actuators at work (closed)
	cycleCount			: UDINT; //completed close/open cycles
	lastCycleTime		: TIME; //duration of the last close/open cycle
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>