		//668 -----------------------------------
		,(code		:= 18967
		,message 	:= '18967.  Error in scaling or in range entry The entries in the table header are inconsistent, e.g. the validity range is empty. If the error is generated during the run time it is a run time error and stops the master/slave group.')
		//669 -----------------------------------
		,(code		:= 18968
		,message 	:= '18968.  Multi table slave out of range The slave master position is outside the table values for the master. The error is a run-time error, and stops the master/slave group.')
