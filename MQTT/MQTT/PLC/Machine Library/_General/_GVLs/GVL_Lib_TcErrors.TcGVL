		,message 	:= '19202.  Control mode not allowed No Target Position Control and no Position Area Control.')
		//684 -----------------------------------
		,(code		:= 19203
		,message 	:= '19203.  Axis is not moving Restart position and velocity is only allowed if axis is physically moving.')
		//685 -----------------------------------
		,(code		:= 19204
		,message 	:= '19204.  Wrong mode for RestartPosAndVelo Wrong mode.')
		//686 -----------------------------------
