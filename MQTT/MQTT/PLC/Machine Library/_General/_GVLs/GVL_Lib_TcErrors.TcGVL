		,(code		:= 18972
		,message 	:= '18972.  Impermissible parameter The Fifo parameter is not allowed.')
		//674 -----------------------------------
		,(code		:= 18973
		,message 	:= '18973.  Fifo is empty The Fifo of the external generator is empty. This can signify end of track or a run time error.')
		//675 -----------------------------------
		,(code		:= 18974
		,message 	:= '18974.  Fifo is full The Fifo of the external generator is full. It is the user?s task to continue to attempt to fill the Fifo with the rejected values.')
		//676 -----------------------------------
		,(code		:= 18975
		,message 	:= '18975.  ?Point-Index of Motion Function invalid?  The point index of a Motion Function Point of a Function Table is invalid. First the point index has to be larger than zero and second it has to be numerical continuously for one column in the Montion Function Table (e.g. 1,2,3,... or 10,11,12,...).')
		//677 -----------------------------------
		,(code		:= 18976
		,message 	:= '18976.  ?No diagonalisation of  matrix? The spline can not be calculated. The master positions are not correct.')
		//678 -----------------------------------
		,(code		:= 18977
		,message 	:= '18977.  ?Number of spline points to less? The number of points of a cubic spline has to be greater than two.')
		//679 -----------------------------------
		,(code		:= 18978
		,message 	:= '18978.  ?Fifo must not be overwritten? Fifo must not be overwritten since then the active line would be overwritten. It is the task of the user to secure that the active line is not modified.')
		//680 -----------------------------------
		,(code		:= 18979
		,message 	:= '18979.  ?Insufficient number of Motion Function points? The number of valid Motion Function points is less than two. Either the entire number of points is to low or the point type of many points is set to Ignore Point.')
		//681 -----------------------------------
		,(code		:= 19200
		,message 	:= '19200.  Axis has been stopped The axis has been stopped while the axis moves to target position. The axis could be stopped with a PLC Command via ADS, with the call of AXFNC or with the TwinCAT System Manager.')
		//682 -----------------------------------
