<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AxisMotionParameters" Id="{a40905c4-b797-4217-80f9-bab87be8dd50}">
    <Declaration><![CDATA[TYPE ST_AxisMotionParameters :
STRUCT
	(* Jog Parameters
	----------------------------------------------------------------------------------------------------*)
	jogSpeed						: LREAL;			// Speed for jogging
	jogAccel						: LREAL;			// Jog Accel
	jogDecel						: LREAL;			// Jog Deccel
	
	(* Relative, absolute, and modulus move Parameters
	----------------------------------------------------------------------------------------------------*)
	relMoveDistance					: LREAL;					
	absMovePosition					: LREAL;			
	absMovePositionId				: INT := GVL_Lib_ServoConstants.EMPTY_POSITION_ID; // Position ID of last absolute move	that used a stored position		
	modMovePosition					: LREAL;			// Position for modulus move
	moveSpeed						: LREAL;	
	moveAccel						: LREAL;			// Accel for all 'move' commands
	moveDecel						: LREAL;			// Decel for all 'move' commands
	
	(* Other Motion Parameters
	----------------------------------------------------------------------------------------------------*)
	jerk							: LREAL;			// Jog, Absolute Move, and index move jerk
	teachPosition					: LREAL;			// Position taught when commanded to teach position
	homePosition					: LREAL;			
	haltDecel						: LREAL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>