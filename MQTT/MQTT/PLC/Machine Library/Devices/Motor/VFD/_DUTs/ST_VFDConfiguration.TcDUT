<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_VFDConfiguration" Id="{3c41db5e-eb49-48ca-8aa9-43b70c051df4}">
    <Declaration><![CDATA[TYPE ST_VFDConfiguration :
STRUCT
	motorId			: T_DeviceNameString; 
	
	profile			: E_FunctionalProfile := E_FunctionalProfile.CiA402;

	//Permissive/interlock configuration
	fwdIntlk		: ST_PermissiveConfiguration;
	fwdPerm			: ST_PermissiveConfiguration;
	revIntlk		: ST_PermissiveConfiguration;
	revPerm			: ST_PermissiveConfiguration;
	
	opTimeout		: TIME := T#300S; //How long operator override will stay on without commands
	opTimeoutEnable	: BOOL := TRUE;
	
	targetVelocity 	: WORD;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>