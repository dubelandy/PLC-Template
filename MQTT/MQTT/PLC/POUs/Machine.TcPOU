<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="Machine" Id="{fd7db330-af26-42b6-9300-14a45f22c7e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Machine EXTENDS FB_Module
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	// Machine Metrics
	stProcessMetrics	: st_ProcessMetrics;
	stStationConfig		: st_StationConfig;
	stRecipe 			: st_Recipe;
	//Test Bits
	bAndy : INT := 0;
	nEquipState: INT;
	bStartMachineSequence: BOOL;
	tWorkTImer : TON;
	fbTransaction     : FB_Transaction;
	//Running State
	nRunningSeq		: INT := 0;
	//
	//fbTriggerTell : FB_TriggerTell;
	//fbMachineTransaction : FB_Transaction;
	// First-scan initialization & control flags
    init            : BOOL := TRUE;
    bWriteJsonFile  : BOOL; // Set this to TRUE in online view to manually trigger a write
    
    // Sample parameters to encode
    sUID            : STRING := 'UID-98745-B';
    fMass           : LREAL := 42.57; // mass in kg/g
    
    // JSON generation variables
    fbJson          : FB_JsonSaxWriter;
    sJsonResult     : STRING(255); // Buffer to hold the generated JSON string
    
    // File writing variables & state machine
    fbFileOpen      : FB_FileOpen;
    fbFileWrite     : FB_FileWrite;
    fbFileClose     : FB_FileClose;
    
    nWriteState     : INT := 0;
    hFile           : UINT; // File handle returned by OS
	sFilePath       : STRING := 'C:\Users\Andy Dubel\Documents\PLC MQTT\JsonOutput.json'; // Path on target system  C:\Users\Andy Dubel\Documents\PLC MQTT

//MQTT 
// Control & Initialization Flags
    //init                : BOOL := TRUE;
    bPublishMqtt        : BOOL; // Manually trigger a message publish in Online View
    
    // Sample Data Payload
    //sUID                : STRING := 'UID-98745-B';
    //fMass               : LREAL := 42.57;
    
    // JSON generation variables
    //fbJson              : FB_JsonSaxWriter;
    //sJsonResult         : STRING(255);
    
    // MQTT Client and Configuration
    fbMqttClient        : FB_IotMqttClient;
    bMqttConnected      : BOOL;
    
    // Topic name (Tip: Add a unique string to the end so others don't overwrite you)
    sTopic              : STRING := 'terminus/machinestate'; 
    
    // Publish helper variables
    nPublishState       : INT := 0;
    fbTimer             : TON; // Keeps the state machine from firing too wildly

// Subscription Control
    sSubTopic           : STRING := 'terminus/machinestate'; 
    bSubscribed         : BOOL;
    
    // Message Storage Buffers
    sReceivedTopic      : STRING(255);
    sReceivedPayload    : STRING(255);
    nPayloadSize        : UDINT;
	
	// NEW: Native Beckhoff Objects to handle incoming messages
    fbMessageQueue      : FB_IotMqttMessageQueue;
    fbMessage           : FB_IotMqttMessage;

    // Helper to detect incoming message events
    bNewMessageReceived : BOOL;	
	wrongKeyDebug : STRING;
	wrongKeyFound : BOOL;
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
fbtransaction();


]]></ST>
    </Implementation>
