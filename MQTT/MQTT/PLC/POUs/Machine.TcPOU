    <Method Name="MapParameters" Id="{1359ade2-c133-4923-8889-64171e208a0f}" FolderPath="Standard\">
      <Declaration><![CDATA[METHOD PROTECTED MapParameters : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbtransaction.stProcessMetrics.fAverageAcceleration := stProcessMetrics.fAverageAcceleration;
fbtransaction.stProcessMetrics.fMaxRecordedSpeed := stProcessMetrics.fMaxRecordedSpeed;
fbtransaction.stProcessMetrics.fTotalCycleDuration := stProcessMetrics.fTotalCycleDuration;
fbtransaction.stProcessMetrics.UID := stProcessMetrics.UID;

fbtransaction.stStationConfig.stationID := stStationConfig.stationID;

stRecipe.fTargetAcceleration :=  fbtransaction.stRecipe.fTargetAcceleration;
stRecipe.fTargetSpeed :=  fbtransaction.stRecipe.fTargetSpeed;;
stRecipe.fTargetTime :=  fbtransaction.stRecipe.fTargetTime;
stRecipe.UID :=  fbtransaction.stRecipe.UID;]]></ST>
