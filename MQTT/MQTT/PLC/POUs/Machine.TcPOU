    <Method Name="RunningSeq" Id="{11e1eebd-b5b0-4c73-8890-400e3abdcc90}" FolderPath="Standard\">
      <Declaration><![CDATA[METHOD PUBLIC RunningSeq : BOOL
VAR_INPUT
END_VAR

VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ===================================================================================
// MAIN EQUIPMENT STATE MACHINE
// ===================================================================================
CASE nEquipState OF

    0: // IDLE
        IF bStartMachineSequence THEN
            bStartMachineSequence := FALSE;
            nEquipState    := 10;
        END_IF

    10: // KICK OFF HANDSHAKE Lifecyle
        // Verify the gateway block is clear and idling
        IF fbtransaction.sts.State = E_TriggerTellState.Idle THEN
            fbtransaction.bWorkDone    := FALSE;
            fbtransaction.bRequest_ACK := FALSE;
            
            fbtransaction.ctrl.start   := TRUE; // Forces gateway to build and publish Attention JSON
            nEquipState               := 15;
        END_IF

    15: // SET REUESt ACK
		IF fbtransaction.sts.State = E_TriggerTellState.Request_Start THEN
			IF FBTransaction.ctrl.sim THEN
				stRecipe.fTargetAcceleration			:= 1.2;
    			stRecipe.fTargetTime         			:= 5.5;
    			stRecipe.fTargetAcceleration 			:= 0.4;
				stRecipe.UID							:= '1234567';	
				fbTransaction.bRequest_ACK :=TRUE;
				nEquipState               := 20;
			ELSE				
				stRecipe.fTargetAcceleration			:= fbtransaction.stRecipe.fTargetAcceleration;
    			stRecipe.fTargetTime         			:= fbtransaction.stRecipe.fTargetTime;
    			stRecipe.fTargetSpeed 					:= fbtransaction.stRecipe.fTargetSpeed;
				stRecipe.UID							:= fbtransaction.stRecipe.UID;	
				fbTransaction.bRequest_ACK :=TRUE;
				nEquipState               := 20;
			END_IF
		END_IF
		
	20: // WAIT FOR RECIPE DATA ARRIVAL OVER MQTT
        // The extended block has autonomously caught, validated, and parsed the parameters
        IF fbtransaction.sts.State = E_TriggerTellState.Working THEN
            
            // Map the freshly delivered values straight to physical motion profiles
            //fbMoveAxis.fVelocity     := fbCaddyComms.stRecipe.fTargetSpeed;
            //fbMoveAxis.fAcceleration := fbCaddyComms.stRecipe.fTargetAcceleration;
            
            // Fire physical machine controls
            //fbMoveAxis.Execute       := TRUE;
            nEquipState              := 30;
        END_IF

    30: // EXECUTING PHYSICAL CYCLES

        tWorkTimer(IN :=TRUE, PT := T#60S);
        IF tWorkTimer.Q THEN
            nEquipState := 40;  // Advance to the next state
        END_IF

    40: // TRIGGER OUTBOUND RESULTS PACKAGING (TELL)
        // Signal the communication engine that physical work is complete.
        // It will pick up the metrics, format the final JSON, and post it over MQTT.
		fbTransaction.stProcessMetrics.fAverageAcceleration := 1.2;
		fbTransaction.stProcessMetrics.fMaxRecordedSpeed := 99;
		fbTransaction.stProcessMetrics.fTotalCycleDuration := TIME_TO_DINT(tWorkTimer.ET)/1000;
		tWorkTimer(IN := FALSE); // Reset the timer input so it's ready for the next use
        fbTransaction.bWorkDone := TRUE; 
        nEquipState            := 50;

    50: // WAIT FOR HANDSHAKE SYSTEM TO TEARDOWN AND SAFELY IDLE
        IF fbTransaction.sts.State = E_TriggerTellState.Idle THEN
            // Handshake lifecycle successfully completed. Whole system is safe.
            nEquipState := 0; 
        END_IF

END_CASE]]></ST>
      </Implementation>
    </Method>
