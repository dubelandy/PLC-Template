    <Method Name="MQTT" Id="{e4ec4825-cc61-46f7-9461-f4f88ea9f04b}">
      <Declaration><![CDATA[METHOD PUBLIC MQTT : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ==========================================
// 1. FIRST SCAN TRIGGER / MANUAL TRIGGER
// ==========================================
IF init THEN
    bWriteJsonFile := TRUE; // Automatically trigger a file write on startup
    init := FALSE;          // Turn off first scan flag
END_IF

// ==========================================
// 2. BUILD THE JSON STRING
// ==========================================
IF bWriteJsonFile AND nWriteState = 0 THEN
    
    fbJson.ResetDocument();
    
    fbJson.StartObject();
        fbJson.AddKey('UID');
        fbJson.AddString(sUID);
        
        fbJson.AddKey('Mass');
        fbJson.AddLReal(fMass);
    fbJson.EndObject();
    
    // Copy the generated JSON out of the writer into our string buffer
    fbJson.CopyDocument(sJsonResult, SIZEOF(sJsonResult));
    
    // Jump to the file-writing state machine
    nWriteState := 1; 
    bWriteJsonFile := FALSE; 
END_IF

// ==========================================
// 3. WRITE TO FILE STATE MACHINE
// ==========================================
CASE nWriteState OF
    0: // Idle state
        ;
        
    1: // Open the file (or create it if it doesn't exist)
        fbFileOpen(
            sNetId := '', // Empty string means local PLC
            sPathName := sFilePath,
            nMode := FOPEN_MODEWRITE OR FOPEN_MODETEXT, // Write mode / Text format
            bExecute := TRUE);
            
        IF NOT fbFileOpen.bBusy THEN
            IF NOT fbFileOpen.bError THEN
                hFile := fbFileOpen.hFile; // Grab the file handle
                nWriteState := 2;
            ELSE
                nWriteState := 99; // Error fallback
            END_IF
            fbFileOpen(bExecute := FALSE); // Reset FB block
        END_IF
        
    2: // Write the JSON string buffer to the file
        fbFileWrite(
            sNetId := '',
            hFile := hFile,
            pWriteBuff := ADR(sJsonResult),
            cbWriteLen := INT_TO_UDINT(LEN(sJsonResult)), // Exact length of string
            bExecute := TRUE);
            
        IF NOT fbFileWrite.bBusy THEN
            IF NOT fbFileWrite.bError THEN
                nWriteState := 3;
            ELSE
                nWriteState := 99;
            END_IF
            fbFileWrite(bExecute := FALSE);
        END_IF
        
    3: // Close the file handle safely
        fbFileClose(
            sNetId := '',
            hFile := hFile,
            bExecute := TRUE);
            
        IF NOT fbFileClose.bBusy THEN
            nWriteState := 0; // Success! Return to Idle
            fbFileClose(bExecute := FALSE);
        END_IF
        
    99: // Error Handling State
        // Add your error/logging trap here if file I/O locks up
        nWriteState := 0; 
END_CASE

// ==========================================
// 1. MQTT BACKGROUND CONNECTION MANAGEMENT
// ==========================================
// This configuration must run cyclically so the client can handle keep-alives and handshakes.
IF fbMqttClient.bConfigured = FALSE THEN
    // Configure public HiveMQ broker settings
    fbMqttClient.sHostName      := 'broker.hivemq.com';
    fbMqttClient.nHostPort    := 1883; // Standard unencrypted MQTT port
    //fbMqttClient.sClientId      := 'Beckhoff_PLC_Client_Unique99'; // Must be unique on the broker
    //fbMqttClient.bConfigured    := TRUE
	fbMqttClient.ipMessageQueue := fbMessageQueue;
END_IF

// Maintain background connection status
fbMqttClient.Execute(bConnect := TRUE);
bMqttConnected := fbMqttClient.bConnected;

// ==========================================
// 2. FIRST SCAN TRIGGER / MANUAL TRIGGER
// ==========================================
IF init THEN
    // Wait briefly for network initialization before trying to publish
    fbTimer(IN := TRUE, PT := T#3S);
    IF fbTimer.Q THEN
        bPublishMqtt := TRUE; 
        init := FALSE; 
        fbTimer(IN := FALSE); // Reset timer
    END_IF
END_IF

// ==========================================
// 3. GENERATE PAYLOAD AND PUBLISH STATE MACHINE
// ==========================================

CASE nPublishState OF
    0: // Idle state - wait for a trigger
        IF bPublishMqtt AND bMqttConnected THEN
            bPublishMqtt := FALSE;
            
            // Build the JSON Payload string
            fbJson.ResetDocument();
            fbJson.StartObject();
                fbJson.AddKey('UID');
                fbJson.AddString(sUID);
                fbJson.AddKey('Mass');
                fbJson.AddLReal(fMass);
            fbJson.EndObject();
            fbJson.CopyDocument(sJsonResult, SIZEOF(sJsonResult));
            
            nPublishState := 1; // Move to publish step
        END_IF
        
    1: // Fire the MQTT Publish command
        // Note: The data pointer must be wrapped using standard PLC type conversion
        IF fbMqttClient.Publish(
            sTopic      := sTopic, 
            pPayload    := ADR(sJsonResult), 
            nPayloadSize:= INT_TO_UDINT(LEN(sJsonResult)), 
            eQoS        := TcIotMqttQos.AtMostOnceDelivery,
            bRetain     := FALSE, 
            bQueue      := FALSE) 
        THEN
            // The Publish method returns TRUE as soon as the message is pushed to the transmission queue
            nPublishState := 0; // Return to idle
        END_IF
        
END_CASE

//SUBSCRIBE

// ==========================================
// 1. MQTT BACKGROUND CONNECTION (Existing)
// ==========================================
fbMqttClient.Execute(bConnect := TRUE);
bMqttConnected := fbMqttClient.bConnected;

// ==========================================
// 2. AUTOMATIC TOPIC SUBSCRIPTION (Corrected Enum)
// ==========================================
IF bMqttConnected AND NOT bSubscribed THEN
    IF fbMqttClient.Subscribe(
        sTopic  := sSubTopic, 
        eQoS    := TcIotMqttQos.AtMostOnceDelivery) 
    THEN
        bSubscribed := TRUE; 
    END_IF
ELSIF NOT bMqttConnected THEN
    bSubscribed := FALSE;
END_IF

// ==========================================
// 3. LISTEN & DEQUEUE INCOMING MESSAGES
// ==========================================
// Check if any messages have piled up inside the queue
IF fbMessageQueue.nQueuedMessages > 0 THEN
    
    // Pull the oldest message out of the FIFO queue
    IF fbMessageQueue.Dequeue(fbMessage := fbMessage) THEN
        
        // Extract the topic string out of the message object
        fbMessage.GetTopic(
            pTopic      := ADR(sReceivedTopic), 
            nTopicSize  := SIZEOF(sReceivedTopic));
            sReceivedPayload := ''; //Andy
			MEMSET(ADR(sReceivedPayload), 0, SIZEOF(sReceivedPayload)); //Andy
        // Extract the payload string out of the message object
        fbMessage.GetPayload(
            pPayload    := ADR(sReceivedPayload), 
            nPayloadSize:= SIZEOF(sReceivedPayload), 
            bSetNullTermination := TRUE); // Keeps string terminators safe
            
        // ==========================================
        // 4. PROCESS YOUR DATA
        // ==========================================
        IF sReceivedPayload = 'RESET' THEN
            wrongKeyFound := FALSE;
            wrongKeyDebug := '';
        END_IF
        
    END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
