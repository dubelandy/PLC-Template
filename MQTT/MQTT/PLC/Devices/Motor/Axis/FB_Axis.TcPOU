    <Method Name="AbsMove" Id="{42042fc5-56d3-485b-a362-2b32992e5cc7}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC AbsMove
VAR_INPUT
	absMovePosition		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMotionParam(param := E_MotorMotionParam.AbsMovePosition, val := absMovePosition);
pcmd := E_AxisCommand.AbsMove;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AbsMoveToStoredPosition" Id="{a6d4401e-5647-488f-884c-517aacc0efd0}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC AbsMoveToStoredPosition : BOOL
// Returns true if position is found in list and move started, false otherwise
VAR_INPUT
	id				: INT; 
END_VAR
VAR
	i				: INT;
	success			: BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Loop through position list to check if the position ID exists and initiate move
FOR i := 0 TO GVL_Lib_ServoConstants.MAX_POSITIONS DO
	// If ID exists in position list
	IF positionList[i].id = id THEN 
		SetMotionParam(param := E_MotorMotionParam.AbsMovePositionId, val := id); // Store commanded position ID
		AbsMove(positionList[i].position); 										  // Initiate absolute move
		success := TRUE;
		EXIT;
	END_IF
END_FOR

AbsMoveToStoredPosition := success;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddFollower" Id="{306c9b0f-11a8-42fb-991b-bff797bce413}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC AddFollower
// Must continuously call function
// Execution of coupling or decoupling will be set by 
// the ctrlAxis.coupleFollower bit
VAR_IN_OUT
	follower : AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(follower) THEN
	mcGearIn(Master := axis, Slave := follower, RatioNumerator := cfg.gearRatio, RatioDenominator := 1); 
	mcGearOut(Slave := follower); 

	IF axis.status.homed AND follower.status.homed AND ctrlAxis.coupleFollower
	AND NOT mcGearIn.InGear AND NOT mcGearIn.Execute THEN
		mcGearIn.Execute := TRUE; 
	END_IF

	IF mcGearIn.Execute AND follower.status.coupled THEN 
		mcGearIn.Execute 		:= FALSE;
		ctrlAxis.coupleFollower := TRUE;
	END_IF

	IF mcGearIn.Error THEN
		mcGearIn.Execute := FALSE;
	END_IF

	IF NOT ctrlAxis.coupleFollower AND follower.Status.Coupled THEN 
		mcGearOut.Execute := TRUE;
	END_IF

	IF mcGearOut.Done THEN 
		mcGearOut.Execute := FALSE;
	END_IF

	fault.coupleError 		:= ctrlAxis.coupleFollower AND (NOT axis.Status.Homed OR NOT follower.Status.Homed);
	fault.followerLagError 	:= ctrlAxis.coupleFollower AND axis.Status.Coupled AND follower.Status.Coupled AND
						  	   ABS(axis.NcToPlc.PosDiff - follower.NcToPlc.PosDiff) > cfg.followerLag;			   
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DefinePosition" Id="{6978d4e4-68a4-4cdf-b913-3acb3852eed1}" FolderPath="Public\Control\Positions\">
      <Declaration><![CDATA[METHOD PUBLIC DefinePosition : INT // Check for blank name before overwriting
VAR_INPUT
	id					: INT; // position id
	position			: LREAL; // value of position (mm)
	name				: STRING := ''; // position name
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF positionList[id].name = '' THEN
	DefinePosition := SavePosition(id := id, position := position, name := name);
ELSE
	DefinePosition := 2; // Position has previously been defined. don't overwrite
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DeletePosition" Id="{3e6f998e-0a79-48f4-8afd-3809b9592483}" FolderPath="Public\Control\Positions\">
      <Declaration><![CDATA[METHOD PUBLIC DeletePosition : INT
VAR_INPUT
	id : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF id >= 0 AND id <= GVL_Lib_ServoConstants.MAX_POSITIONS THEN
	positionList[id].name := '';
	positionList[id].position := 0.0;
	DeletePosition := 1; //position deleted, code = 1
ELSE
	DeletePosition := -1; //id out of bounds, code = -1
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Device" Id="{c57fa322-cf7e-4eef-82b7-fb9698890b60}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD Device : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// to FB device
opTimeout  			 := cfg.opTimeout;
opTimeoutEnable 	 := cfg.opTimeoutEnable;
opActivity 			 := ocmd <> E_AxisCommand.None;

// from FB device
sts.mode	   		 := mode;
sts.modeAuto   		 := sts.mode = E_SystemMode.Auto;
sts.modeManual 		 := sts.mode = E_SystemMode.Manual;
sts.manualOvrde		 := ctrl.manualOvrde; 	
sts.bypass 	   		 := ctrl.bypass;		
sts.sim		   		 := ctrl.sim;			
sts.parentConfigured := parentConfigured;]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisableCouple" Id="{9e5a1d61-bf93-41c1-96c3-d482bfec3d20}" FolderPath="Public\Control\">
      <Declaration><![CDATA[METHOD DisableCouple : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ctrlAxis.coupleFollower := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisableLag" Id="{7054c8a6-580f-4903-a33b-93626b53ec8b}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC DisableLag]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_AxisCommand.DisableLag;]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnableCouple" Id="{11393df5-1b0e-4dbe-a7eb-0dbde03849a9}" FolderPath="Public\Control\">
      <Declaration><![CDATA[METHOD EnableCouple : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ctrlAxis.coupleFollower := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnableLag" Id="{5793d898-f33f-4c30-93b9-df95cfed9a99}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC EnableLag]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_AxisCommand.EnableLag;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Functions" Id="{9bba8fd3-f3a5-44d4-8a1a-eb8cfc0bdc65}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED Functions
VAR
	i 				: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Default function FB calls
----------------------------------------------------------------------------------------------------*)
func.AbsMove(				 	hmiTextStatic := CONCAT(cfg.motorId, ' absolute move'));
func.AbsMoveToStoredPosition(	hmiTextStatic := CONCAT(cfg.motorId, ' absolute move to stored position'));
func.RelMove(					hmiTextStatic := CONCAT(cfg.motorId, ' relative move'));
func.ModMove(				 	hmiTextStatic := CONCAT(cfg.motorId, ' modulus move'));
func.LatchJogFwd(			 	hmiTextStatic := CONCAT(cfg.motorId, ' latch jog forward'));
func.LatchJogRev(				hmiTextStatic := CONCAT(cfg.motorId, ' latch jog reverse'));
func.Home(						hmiTextStatic := CONCAT(cfg.motorId, ' home'));
func.Stop(						hmiTextStatic := CONCAT(cfg.motorId, ' stop'));
func.Couple(					hmiTextStatic := CONCAT(cfg.motorId, ' coupling follower'));
func.Decouple(					hmiTextStatic := CONCAT(cfg.motorId, ' decoupling follower'));
func.ResetDoneBits(				hmiTextStatic := CONCAT(cfg.motorId, ' reset done bits'));

(* Default functions
----------------------------------------------------------------------------------------------------*)

IF func.AbsMove.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.AbsMove.arrParam[i].typeEnum OF
			E_AxisFunctionParam.AbsMovePosition:
				SetMotionParam(param	:= E_MotorMotionParam.AbsMovePosition,
							   val		:= func.AbsMove.arrParam[i].value);
			E_AxisFunctionParam.MoveSpeed:
				SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
							   val		:= func.AbsMove.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.AbsMove.running THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.AbsMove.arrParam[i].typeEnum = E_AxisFunctionParam.MoveSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
						   val		:= func.AbsMove.arrParam[i].value);
		END_IF
	END_FOR
	// Wait for complete conditions
	func.AbsMove.permComplete.perm.0 S= sts.absMoveComplete;
	
	// Call Action
	IF NOT func.AbsMove.complete AND NOT fault.active
	AND sts.state <> E_AxisState.AbsMove_A AND sts.state <> E_AxisState.AbsMove_B THEN
		// Passing in this motion parameter has the effect of reassigning its own 
		// value to itself. It's done because this input is required for the method
		AbsMove(motionParam.absMovePosition);
	END_IF
	
	func.AbsMove.inpError := fault.active;
END_IF


IF func.AbsMoveToStoredPosition.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.AbsMoveToStoredPosition.arrParam[i].typeEnum OF
			E_AxisFunctionParam.AbsMovePositionId:
				SetMotionParam(param	:= E_MotorMotionParam.AbsMovePositionId,
							   val		:= func.AbsMoveToStoredPosition.arrParam[i].value);
			E_AxisFunctionParam.MoveSpeed:
				SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
							   val		:= func.AbsMoveToStoredPosition.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.AbsMoveToStoredPosition.running THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.AbsMoveToStoredPosition.arrParam[i].typeEnum = E_AxisFunctionParam.MoveSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
						   val		:= func.AbsMoveToStoredPosition.arrParam[i].value);
		END_IF
	END_FOR
	// Wait for complete conditions
	func.AbsMoveToStoredPosition.permComplete.perm.0 S= sts.absMoveComplete;	
	
	// Call Action
	IF NOT func.AbsMoveToStoredPosition.complete AND NOT fault.active
	AND sts.state <> E_AxisState.AbsMove_A AND sts.state <> E_AxisState.AbsMove_B THEN
		AbsMoveToStoredPosition(motionParam.absMovePositionId);
	END_IF
	
	func.AbsMoveToStoredPosition.inpError := fault.active;
END_IF


IF func.RelMove.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.RelMove.arrParam[i].typeEnum OF
			E_AxisFunctionParam.RelMoveDistance:
				SetMotionParam(param	:= E_MotorMotionParam.RelMoveDistance,
							   val		:= func.RelMove.arrParam[i].value);
			E_AxisFunctionParam.MoveSpeed:
				SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
							   val		:= func.RelMove.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.RelMove.running THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.RelMove.arrParam[i].typeEnum = E_AxisFunctionParam.MoveSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
						   val		:= func.RelMove.arrParam[i].value);
		END_IF
	END_FOR
	// Wait for complete conditions
	func.RelMove.permComplete.perm.0 S= sts.RelMoveComplete;
	
	// Call Action
	IF NOT func.RelMove.complete AND NOT fault.active
	AND sts.state <> E_AxisState.RelMove_A AND sts.state <> E_AxisState.RelMove_B THEN
		RelMove(motionParam.relMoveDistance);
	END_IF
	
	func.RelMove.inpError := fault.active;
END_IF


IF func.ModMove.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.ModMove.arrParam[i].typeEnum OF
			E_AxisFunctionParam.ModMovePosition:
				SetMotionParam(param	:= E_MotorMotionParam.ModMovePosition,
							   val		:= func.ModMove.arrParam[i].value);
			E_AxisFunctionParam.MoveSpeed:
				SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
							   val		:= func.ModMove.arrParam[i].value);
		END_CASE
	END_FOR
	END_IF
IF func.ModMove.running THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.ModMove.arrParam[i].typeEnum = E_AxisFunctionParam.MoveSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.MoveSpeed,
						   val		:= func.ModMove.arrParam[i].value);
		END_IF
	END_FOR
	// Wait for complete conditions
	func.ModMove.permComplete.perm.0 S= sts.ModMoveComplete;
	
	// Call Action
	IF NOT func.ModMove.complete AND NOT fault.active
	AND sts.state <> E_AxisState.ModMove_A AND sts.state <> E_AxisState.ModMove_B THEN
		ModMove(motionParam.modMovePosition);
	END_IF

	func.ModMove.inpError := fault.active;
END_IF


IF func.LatchJogFwd.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.LatchJogFwd.arrParam[i].typeEnum OF
			E_AxisFunctionParam.JogSpeed: 
				SetMotionParam(param	:= E_MotorMotionParam.JogSpeed,
							   val		:= func.LatchJogFwd.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.LatchJogFwd.active THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.LatchJogFwd.arrParam[i].typeEnum = E_AxisFunctionParam.JogSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.JogSpeed,
						   val		:= func.LatchJogFwd.arrParam[i].value);
		END_IF
	END_FOR	
	// Call Action
	IF NOT fault.active THEN
		LatchJogFwd();
	END_IF
	
	// Wait for complete conditions
	func.LatchJogFwd.permComplete.perm.0 S= sts.jogFwdInProgress;
	
	func.LatchJogFwd.inpError := fault.active;
END_IF


IF func.LatchJogRev.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.LatchJogRev.arrParam[i].typeEnum OF
			E_AxisFunctionParam.JogSpeed:
				SetMotionParam(param	:= E_MotorMotionParam.JogSpeed,
							   val		:= func.LatchJogRev.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.LatchJogRev.running THEN
	// Check for speed change mid move
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		IF func.LatchJogRev.arrParam[i].typeEnum = E_AxisFunctionParam.JogSpeed THEN
			SetMotionParam(param	:= E_MotorMotionParam.JogSpeed,
						   val		:= func.LatchJogRev.arrParam[i].value);
		END_IF
	END_FOR	
	// Call Action
	IF NOT fault.active THEN
		LatchJogRev();
	END_IF
	
	// Wait for complete conditions
	func.LatchJogRev.permComplete.perm.0 S= sts.jogRevInProgress;
	
	func.LatchJogRev.inpError := fault.active;
END_IF



IF func.Home.entry THEN
	FOR i := GVL_Lib_SequencerConstants.MIN_PARAMETERS TO GVL_Lib_SequencerConstants.MAX_PARAMETERS DO
		CASE func.Home.arrParam[i].typeEnum OF
			E_AxisFunctionParam.HomePosition:
				SetMotionParam(param	:= E_MotorMotionParam.HomePosition,
							   val		:= func.Home.arrParam[i].value);
		END_CASE
	END_FOR
END_IF
IF func.Home.running THEN
	// Wait for complete conditions
	func.Home.permComplete.perm.0 S= sts.homingComplete OR ctrl.sim;
	
	// Call Action
	IF NOT func.Home.complete AND NOT fault.active
	AND sts.state <> E_AxisState.Homing THEN
		Home();
	END_IF
	
	func.Home.inpError := fault.active;
END_IF

IF func.Stop.running THEN
	// Wait for complete conditions	
	func.Stop.permComplete.perm.0 S= sts.stopComplete;
	
	// Call action
	IF NOT func.Stop.complete AND NOT fault.active
	AND sts.state <> E_AxisState.Halting THEN
		Stop();
	END_IF
END_IF


IF func.Couple.running THEN
	ctrlAxis.coupleFollower := TRUE;
	func.Couple.PermComplete.perm.0 := sts.coupled;
END_IF


IF func.Decouple.running THEN
	ctrlAxis.coupleFollower := FALSE;
	func.Decouple.PermComplete.perm.0 := NOT sts.coupled;
END_IF


IF func.ResetDoneBits.running THEN
	ctrlAxis.resetDoneBits := TRUE;
	func.ResetDoneBits.permComplete.perm.0 := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="HandleFaults" Id="{105be416-fe06-44b8-9540-2579dc412c06}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED HandleFaults : BOOL
VAR
	i					: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* ----- Set Faults ----- *)
// Axis Drive Device Error
IF axis.Status.DriveDeviceError THEN
	fault.driveDeviceError := TRUE;
END_IF

// Axis IO Data Invalid
IF axis.Status.IoDataInvalid THEN
	fault.ioDataInvalid := TRUE;
END_IF

// MC_Power Timeout
mcPowerTimeout(IN := (sts.enable AND sts.state > E_AxisState.Power) AND NOT axis.Status.Operational AND NOT resetErrorAndDrive, PT := T#15S);
IF mcPowerTimeout.Q THEN
	fault.mcPowerTimeout := TRUE;
END_IF

// MC_Power Error
IF mc.power.Error THEN
	fault.mcPowerError := TRUE;
END_IF

// MC_MoveVelo Error
IF mc.moveVelocityA.Error OR mc.moveVelocityB.Error THEN
	fault.mcMoveVeloError := TRUE;
END_IF

// MC_MoveAbs Error
IF mc.moveAbsoluteA.Error OR mc.moveAbsoluteB.Error THEN
	fault.mcMoveAbsError := TRUE;
END_IF

// MC_MoveMod Error
IF mc.moveModuloA.Error OR mc.moveModuloB.Error THEN
	fault.mcMoveModError := TRUE;
END_IF

// MC_Halt Command Aborted
IF mc.halt.CommandAborted THEN
	fault.mcHaltCmdAborted := TRUE;
END_IF

// MC_Halt Error
IF mc.halt.Error THEN
	fault.mcHaltError := TRUE;
END_IF

// MC_SetPosition Error
IF mc.setPosition.Error OR mc.readOffset.Error OR mc.writeOffset.Error THEN  //McSetPosition.Error OR
	fault.mcSetPositionError := TRUE;
END_IF

// MC_EnableLag Error
IF mc.enableLag.Error THEN
	fault.mcEnableLagError := TRUE;
END_IF

// MC_DisableLag Error
IF mc.disableLag.Error THEN
	fault.mcDisableLagError := TRUE;
END_IF

// MC_Homing Error
IF mc.homing.Error THEN
	fault.mcHomeError := TRUE;
END_IF

// MC_Reset Error
IF mc.reset.Error THEN
	fault.mcResetError := TRUE;
END_IF

// FB_SoEReset Error
IF mc.resetSoe.Error AND NOT sts.sim THEN
	fault.mcResetSoeError := TRUE;
END_IF

// Other Errors
// (See AddFollower method for more coupling-related errors)
fault.mcGearError := mcGearIn.Error;
fault.external    := inpFault;

(* ----- Handle Reset ----- *)
// The axis will be reset in the upcoming functions call. If that fails, the
// flags will be set high again on the next loop.
IF resetErrorAndDrive THEN
	fault.driveNotOK				:= FALSE;
	fault.driveStateNotOP			:= FALSE;
	fault.driveDeviceError			:= FALSE;
	fault.ioDataInvalid				:= FALSE;
	fault.mcPowerTimeout			:= FALSE;
	fault.mcPowerError				:= FALSE;
	fault.mcMoveVeloError			:= FALSE;
	fault.mcMoveAbsError			:= FALSE;
	fault.mcMoveModError			:= FALSE;
	fault.mcHaltCmdAborted			:= FALSE;
	fault.mcHaltError				:= FALSE;
	fault.mcSetPositionError		:= FALSE;
	fault.mcResetError				:= FALSE;
	fault.mcResetSoeError			:= FALSE;
	fault.mcEnableLagError			:= FALSE;
	fault.mcDisableLagError			:= FALSE;
	fault.mcHomeError				:= FALSE;
	fault.mcGearError				:= FALSE;
	fault.fwdIntlkDisabled 			:= FALSE;
	fault.revIntlkDisabled			:= FALSE;
	fault.coupleError				:= FALSE;
	fault.followerLagError			:= FALSE;
	fault.external					:= FALSE;
	fault.id						:= 0;
	safeDisable						:= FALSE;
	homingInProgress				:= FALSE;
END_IF

IF fault.active THEN
  IF mc.faultId.power <> 0 THEN
	fault.id := mc.faultId.power;
  ELSIF mc.faultId.moveVelocityA <> 0 THEN
	fault.id := mc.faultId.MoveVelocityA;
  ELSIF mc.faultId.moveVelocityB <> 0 THEN
	fault.id := mc.faultId.MoveVelocityB;
  ELSIF mc.faultId.moveAbsoluteA <> 0 THEN
	fault.id := mc.faultId.MoveAbsoluteA;
  ELSIF mc.faultId.moveAbsoluteB <> 0 THEN
	fault.id := mc.faultId.MoveAbsoluteB;
  ELSIF mc.faultId.moveModuloA <> 0 THEN
	fault.id := mc.faultId.MoveModuloA;
  ELSIF mc.faultId.moveModuloB <> 0 THEN
	fault.id := mc.faultId.MoveModuloB;
  ELSIF mc.faultId.halt <> 0 THEN
 	fault.id := mc.faultId.Halt;
  ELSIF mc.faultId.setPosition <> 0 THEN
	fault.id := mc.faultId.SetPosition;
  ELSIF mc.faultId.readOffset <> 0 THEN
	fault.id := mc.faultId.ReadOffset;
  ELSIF mc.faultId.writeOffset <> 0 THEN
	fault.id := mc.faultId.WriteOffset;
  ELSIF mc.faultId.enableLag <> 0 THEN
	fault.id := mc.faultId.EnableLag;
  ELSIF mc.faultId.disableLag <> 0 THEN
	fault.id := mc.faultId.DisableLag;
  ELSIF mc.faultId.homing <> 0 THEN
	fault.id := mc.faultId.Homing;
  ELSIF mc.faultId.reset <> 0 THEN
	fault.id := mc.faultId.Reset;
  ELSIF mc.faultId.resetSoeAds <> 0 AND NOT sts.sim THEN 
	fault.id := mc.faultId.resetSoeAds;
  ELSIF mc.faultId.resetSoeSercos <> 0 THEN
	fault.id := mc.faultId.resetSoeSercos;
  END_IF
  ELSE fault.id := 0; 
END_IF 

// Write message of error on change
IF fault.id = 0 THEN
	fault.ncText := GVL_Lib_TcErrors.List[0].message;
ELSIF lastFaultId <> fault.id THEN
	FOR i := 0 TO GVL_Lib_TcErrors.MAX_INDEX DO
		IF GVL_Lib_TcErrors.List[i].code = fault.id THEN
			fault.ncText := GVL_Lib_TcErrors.List[i].message;
			EXIT;
		END_IF
	END_FOR
END_IF

IF safeDisable THEN // FIXME: Remove once this is configured in our UDT
	IF NOT fwdIntlk.sts.OK AND sts.movingFwd THEN
		fault.inText := CONCAT('Disabled: interlocks lost during motion. fwdIntlk: ', WORD_TO_BINSTR(fwdIntlk.sts.perm, 16));
		fault.fwdIntlkDisabled := TRUE;
	ELSIF NOT revIntlk.sts.OK AND sts.movingRev THEN
		fault.inText := CONCAT('Disabled: interlocks lost during motion. revIntlk: ', WORD_TO_BINSTR(revIntlk.sts.perm, 16));
		fault.revIntlkDisabled := TRUE;
	ELSE
		fault.inText := 'Disabled: external Safe command received.';
	END_IF
ELSIF fault.external THEN
	fault.inText := inpFaultText;
ELSIF fault.mcGearError THEN // FIXME: Remove once this is configured in our UDT
	fault.inText := 'Follower could not be coupled. (Coupling will fail if either axis is moving or faulted for a different reason).';
ELSIF fault.coupleError THEN
	fault.inText := 'Follower could not be coupled. At least one motor was never homed.';
ELSIF fault.followerLagError THEN
	fault.inText := 'Follower lag exceeded the configured threshold';
ELSE
	fault.inText := '';
END_IF

(* ----- Aggregate Faults ----- *)
fault.active := fault.driveNotOK 				OR fault.driveStateNotOP 
				  OR fault.driveDeviceError 	OR fault.ioDataInvalid
				  OR fault.mcPowerTimeout 		OR fault.mcPowerError
				  OR fault.mcMoveVeloError  	OR fault.mcMoveAbsError
				  OR fault.mcMoveModError 		OR fault.mcHomeError
				  OR fault.mcDisableLagError 	OR fault.mcEnableLagError 
				  OR fault.mcHaltCmdAborted 	OR fault.mcHaltError
				  OR fault.mcResetError			OR fault.mcResetSoeError
				  OR fault.mcSetPositionError 	OR safeDisable
				  OR fault.fwdIntlkDisabled		OR fault.revIntlkDisabled
				  OR fault.mcGearError			OR fault.coupleError
				  OR fault.followerLagError		OR fault.external;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hmi" Id="{ba7a9fc9-241c-4efa-921f-d4f8b2c17a8a}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED Hmi
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ctrlAxis.loadPosition THEN
	ctrlAxis.loadPosition := FALSE;
	LoadPosition(
		id := ctrlAxis.positionToEdit.id,
		position => ctrlAxis.positionToEdit.position,
		name => ctrlAxis.positionToEdit.name
	);
END_IF

IF ctrlAxis.savePosition THEN
	ctrlAxis.savePosition := FALSE;
	SavePosition(
		id := ctrlAxis.positionToEdit.id,
		position := ctrlAxis.positionToEdit.position,
		name := ctrlAxis.positionToEdit.name
	);
END_IF]]></ST>
      </Implementation>
    </Method>
