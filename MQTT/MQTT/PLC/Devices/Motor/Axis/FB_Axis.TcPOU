	position		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMotionParam(param := E_MotorMotionParam.TeachPosition, val := position);
pcmd := E_AxisCommand.TeachPositionTemp;]]></ST>
      </Implementation>
    </Method>
