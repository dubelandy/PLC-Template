<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Axis" Id="{74345266-d6f1-45a5-8ba4-0b49c78e2456}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Axis EXTENDS FB_Device IMPLEMENTS I_SpeedController
VAR_INPUT
	localEnable		: BOOL; // Enable signal from local Estops, etc. If parent control is configured for enable with no local enable, this can be latched true
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	cfg				: ST_AxisConfiguration; 
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	ctrlAxis		: ST_AxisControl;
	
	{attribute 'OPC.UA.DA' := '1'} 
	ocmd			: E_AxisCommand;
	
	func			: ST_AxisFunctions;
	
	(* Interlocks/Permissives
	----------------------------------------------------------------------------------------------------*)
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	fwdIntlk		: FB_Permissive;	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	fwdPerm			: FB_Permissive; 
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	revIntlk		: FB_Permissive; 
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	revPerm			: FB_Permissive; 
	
	(* External inputs
	----------------------------------------------------------------------------------------------------*)
	inpHomeProx AT %I* : BOOL; 				// Link this to home sensor in MapInputs method of Parent
	driveDiagnosticNumber AT %I* : UDINT;	// Link to AX5000 S-0-0390 Diagnostic number
	inpFault		   : BOOL;
	inpFaultText	   : T_MaxString;
END_VAR

VAR_OUTPUT
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	motionParam	: ST_AxisMotionParameters;
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	sts			: ST_AxisStatus; 

	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}	
	fault		: ST_AxisFault;
END_VAR

VAR PERSISTENT
	offset			: LREAL; // Offset for zero position
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	positionList	: ARRAY[0..GVL_Lib_ServoConstants.MAX_POSITIONS] OF ST_AxisPosition;
END_VAR

VAR
	axis					: AXIS_REF; 			 // Linked to Motion Axis Object	
	mc						: ST_AxisMotionControl;  // Motion Commands and Parameters
	saveData				: FB_WritePersistentData;
	savePositionListData	: BOOL;	
	resetErrorAndDrive		: BOOL;	
	safeDisable				: BOOL;					 // Disable drive after a safe command, must reset errors to resume operation	
	homingInProgress		: BOOL;					 // Internal bit to set complete flag after homing offset is stored
	mcGearIn				: MC_GearIn;
	mcGearOut				: MC_GearOut;
	
	(* State
	----------------------------------------------------------------------------------------------------*)
	lastGoodState			: E_AxisState;
	nextState				: E_AxisState;
	lastFaultId				: UDINT;
	
	(* Servo Commands
	----------------------------------------------------------------------------------------------------*)
	cmdReceived				: E_AxisCommand;	
	cmdReceivedLast			: E_AxisCommand;	
	pcmd					: E_AxisCommand;	
	pcmdLast				: E_AxisCommand;	
	ocmdLast				: E_AxisCommand;
	storedRelMovePosition	: LREAL;	
	
	(* Speed history/triggers
	----------------------------------------------------------------------------------------------------*)
	jogSpeedLast			: LREAL; 	
	jogSpeedChanged			: BOOL; 	// Jog speed has changed
	ftJogSpeedChanged		: F_TRIG;
	moveSpeedLast			: LREAL;
	moveSpeedChanged		: BOOL;		// Move speed has changed
	ftMoveSpeedChanged		: F_TRIG;
	ftRelMove				: F_TRIG;
	rtAbsMoveADone			: R_TRIG;
	rtAbsMoveBDone			: R_TRIG;
	rtModMoveADone			: R_TRIG;
	rtModMoveBDone			: R_TRIG;

	(* General
	----------------------------------------------------------------------------------------------------*)	
	enableAxisDelay			: TON;
	mcPowerTimeout			: TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();

Hmi();
StatusIn();
ProcessCommands();
Device();
StateMachine();
MotionControl();
HandleFaults();
StatusOut();
Functions();
SetPositionIds();
]]></ST>
    </Implementation>
    <Folder Name="Protected" Id="{19fe0ac5-519c-4cf9-9fee-d537cf521bda}">
      <Folder Name="Commands" Id="{8617afc4-5364-4bbf-a811-312114518621}" />
      <Folder Name="Logic" Id="{15365a68-b884-4f19-a014-fb338803af7d}" />
    </Folder>
    <Folder Name="Public" Id="{6595ad5e-96e9-44b2-98ef-b36522130c09}">
      <Folder Name="Commands" Id="{551af2bb-f896-4954-b0ec-281227420464}" />
      <Folder Name="Control" Id="{34cdcaf3-9c91-4541-81b5-9a73368a2a90}">
        <Folder Name="Positions" Id="{e86188a7-85b7-4932-b393-2387f4302d69}" />
