      <Implementation>
        <ST><![CDATA[pcmd := E_AxisCommand.JogRev;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LatchJogFwd" Id="{f939658d-f0ae-4d1e-a083-1c26591c40fa}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC LatchJogFwd ]]></Declaration>
      <Implementation>
