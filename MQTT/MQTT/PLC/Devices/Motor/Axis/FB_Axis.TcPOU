    <Method Name="LoadPosition" Id="{e396483e-069b-4c06-a0ec-fd3575073509}" FolderPath="Public\Control\Positions\">
      <Declaration><![CDATA[METHOD PUBLIC LoadPosition : INT
VAR_INPUT
	id : INT;
END_VAR
VAR_OUTPUT
	position : LREAL;
	name : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF id >= 0 AND id <= GVL_Lib_ServoConstants.MAX_POSITIONS THEN
	name := positionList[id].name;
	position := positionList[id].position;
	LoadPosition := 1; //position found, code = 1
ELSE
	LoadPosition := -1; //id out of bounds, code = -1
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ModMove" Id="{6b1fac92-8420-4509-9072-f3dfb8d517e5}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC ModMove
VAR_INPUT
	modMovePosition		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMotionParam(param := E_MotorMotionParam.ModMovePosition, val := modMovePosition);
pcmd := E_AxisCommand.ModMove;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MotionControl" Id="{0bc6ccd8-e936-4da8-b0d2-974e90fe4d04}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED MotionControl
VAR
	absMovePos	 : LREAL;
	haltDecel 	 : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Enable the Axis
mc.power(
	Axis				:=	axis, 
	Enable				:=	sts.enable AND sts.state >= E_AxisState.Power,
	Enable_Positive		:=	fwdIntlk.sts.OK, 
	Enable_Negative		:=	revIntlk.sts.OK,
	Override			:=	cfg.powerOverride, 	// 1-100%, 100% typ
	BufferMode			:=	mc.bufferMode, 	 	// MC_Aborting -> Immediate disable; MC_Buffered -> Wait for motion commands to finish before disable
	Status				=>, 
	Busy				=>, 
	Active				=>, 
	Error				=>, 
	ErrorID				=>	mc.faultId.power);

// Move Velocity (A)
mc.moveVelocityA(
	Axis			:=	axis, 
	Execute			:=	(sts.state = E_AxisState.JogFwd_A) 		OR (sts.state = E_AxisState.JogRev_A)
					OR	(sts.state = E_AxisState.LatchJogFwd_A)	OR (sts.state = E_AxisState.LatchJogRev_A), 
	Velocity		:=	motionParam.jogSpeed, 
	Acceleration	:=	motionParam.jogAccel, 
	Deceleration	:=	motionParam.jogDecel, 
	Jerk			:=	motionParam.jerk, 
	Direction		:=	mc.moveDirection, 
	BufferMode		:=	mc.bufferMode, 
	Options			:=	(* Use default values *), 
	InVelocity		=>, 
	Busy			=>, 
	Active			=>, 
	CommandAborted	=>, 
	Error			=>,  
	ErrorID			=>	mc.faultId.moveVelocityA);

// Move Velocity (B)
mc.moveVelocityB(
	Axis			:=	axis, 
	Execute			:=	(sts.state = E_AxisState.JogFwd_B) 		OR (sts.state = E_AxisState.JogRev_B)
					OR	(sts.state = E_AxisState.LatchJogFwd_B) 	OR (sts.state = E_AxisState.LatchJogRev_B), 
	Velocity		:=	motionParam.jogSpeed,    
	Acceleration	:=	motionParam.jogAccel,    
	Deceleration	:=	motionParam.jogDecel,    
	Jerk			:=	motionParam.jerk,    
	Direction		:=	mc.moveDirection, 
	BufferMode		:=	mc.bufferMode,   
	Options			:=	(* Use default values *), 
	InVelocity		=>, 
	Busy			=>, 
	Active			=>, 
	CommandAborted	=>, 
	Error			=>, 
	ErrorID			=>	mc.faultId.moveVelocityB);

// Calculate Move Position (Absolute or Relative)
IF sts.state = E_AxisState.AbsMove_A OR sts.state = E_AxisState.AbsMove_B THEN
	absMovePos := motionParam.absMovePosition;
ELSIF sts.state = E_AxisState.RelMove_A OR sts.state = E_AxisState.RelMove_B THEN
	absMovePos := storedRelMovePosition;
END_IF

// Move Absolute (A)
mc.moveAbsoluteA(
	Axis			:=	axis,
	Execute			:=	sts.state = E_AxisState.AbsMove_A OR sts.state = E_AxisState.RelMove_A,
	Position		:=	absMovePos,
	Velocity		:=	motionParam.moveSpeed,
	Acceleration	:=	motionParam.moveAccel,
	Deceleration	:=	motionParam.moveDecel,
	Jerk			:=	motionParam.jerk,
	BufferMode		:=	mc.bufferMode,
	Options			:=	(* Use default values *),
	Done			=>,
	Busy			=>,
	Active			=>,
	CommandAborted	=>,
	Error			=>, 
	ErrorID			=> mc.faultId.moveAbsoluteA);

// Move Absolute (B)
mc.moveAbsoluteB(
	Axis			:=	axis,
	Execute			:=	sts.state = E_AxisState.AbsMove_B OR sts.state = E_AxisState.RelMove_B,
	Position		:=	absMovePos,
	Velocity		:=	motionParam.moveSpeed,
	Acceleration	:=	motionParam.moveAccel,
	Deceleration	:=	motionParam.moveDecel,
	Jerk			:=	motionParam.jerk,
	BufferMode		:=	mc.bufferMode,
	Options			:=	(* Use default values *),
	Done			=>,
	Busy			=>,
	Active			=>,
	CommandAborted	=>,
	Error			=>, 
	ErrorID			=> mc.faultId.moveAbsoluteB
);

// Move Modulo (A)
mc.moveModuloA(
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.ModMove_A,
	Position		:= motionParam.modMovePosition,
	Velocity		:= motionParam.moveSpeed,
	Acceleration	:= motionParam.moveAccel,
	Deceleration	:= motionParam.moveDecel,
	Jerk			:= motionParam.jerk,
	Direction		:= MC_Positive_Direction,
	BufferMode		:= mc.bufferMode,
	Options			:=,
	Done			=>,
	Busy			=>,
	Active			=>,
	CommandAborted	=>,
	Error			=>,
	ErrorId			=> mc.faultId.moveModuloA,
	);

// Move Modulo (B)
mc.moveModuloB(
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.ModMove_B,
	Position		:= motionParam.modMovePosition,
	Velocity		:= motionParam.moveSpeed,
	Acceleration	:= motionParam.moveAccel,
	Deceleration	:= motionParam.moveDecel,
	Jerk			:= motionParam.jerk,
	Direction		:= MC_Positive_Direction,
	BufferMode		:= mc.bufferMode,
	Options			:=,
	Done			=>,      
	Busy			=>,      
	Active			=>,      
	CommandAborted	=>,      
	Error			=>,     
	ErrorId			=> mc.faultId.moveModuloB
	);
	
// Halt
haltDecel := motionParam.haltDecel;
IF haltDecel = 0 THEN
	haltDecel := motionParam.moveDecel;
END_IF
mc.halt(
	Axis			:= axis, 
	Execute			:= sts.state = E_AxisState.Halting  OR sts.state = E_AxisState.Faulting, 
	Deceleration	:= haltDecel, 
	Jerk			:= motionParam.jerk, 
	BufferMode		:= MC_Aborting, 
	Options			:=	(* Use default values *), 
	Done			=>, 
	Busy			=>, 
	Active			=>, 
	CommandAborted	=>, 
	Error			=>,  
	ErrorID			=> mc.faultId.halt);
	
// Teach Position
mc.setPosition(
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.TeachPositionTemp,
	Position		:= motionParam.teachPosition,
	Mode			:= FALSE,
	Done			=>,
	Busy			=>,
	Error			=>, 
	ErrorID			=> mc.faultId.setPosition);

// Read offset
mc.readOffset(
	Enable 			:= sts.state = E_AxisState.TeachPosition_Read OR sts.state = E_AxisState.InitReadPosition,
	ParameterNumber := AxisEncoderOffset,
	Axis 			:= axis,
	Value 			=>,
	Busy			=>,
	Error			=>, 
	ErrorID			=>	mc.faultId.readOffset);

// Write offset		
mc.writeOffset(
	Execute 		:= sts.state = E_AxisState.TeachPosition_Write OR sts.state = E_AxisState.InitSetPosition,
	ParameterNumber := AxisEncoderOffset,
	Value 			:= offset,
	Axis 			:= axis,
	Busy			=>,
	Error			=>, 
	ErrorID			=> mc.faultId.writeOffset);	
	
// Enable Lag
mc.enableLag(	
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.EnableLag,
	ParameterNumber := MC_AxisParameter.EnablePosLagMonitoring,
	Value			:= TRUE,
	Done			=>,
	Error			=>,
	ErrorID			=> mc.faultId.enableLag);
	
// Disable Lag
mc.disableLag(	
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.DisableLag,
	ParameterNumber := MC_AxisParameter.EnablePosLagMonitoring,
	Value			:= FALSE,
	Done			=>,
	Error			=>,
	ErrorID			=> mc.faultId.disableLag);
	
// Homing
mc.homing(
	Axis			:= axis,
	Execute			:= sts.state = E_AxisState.Homing,
	Position		:= motionParam.homePosition,
	HomingMode		:= cfg.homingMode,
	bCalibrationCam	:= inpHomeProx,
	Done			=>,
	Busy			=>,
	Error			=>,
	ErrorId			=> mc.faultId.homing);
	
// Fault Reset
mc.reset(
	Axis		:=	axis, 
	Execute		:=	resetErrorAndDrive OR sts.state = E_AxisState.ResetDrive,
	Done		=>, 
	Busy		=>, 
	Error		=>, 
	ErrorID		=>  mc.faultId.reset);

// Reset - Used for beckhoff servos.
mc.resetSoe(
	NetId		:=	'', 
	Execute		:=	(resetErrorAndDrive OR sts.state = E_AxisState.ResetDrive) AND cfg.isBeckhoffServo AND NOT sts.sim,
	Timeout		:=	T#10S,	// FbSoEReset can take up to 10 seconds 
	Axis		:=	axis, 
	Busy		=>, 
	Error		=>, 
	AdsErrId	=>	, 
	SercosErrId	=>	);
mc.faultId.resetSoeAds 		:= UINT_TO_UDINT(mc.resetSoe.AdsErrId);	
mc.faultId.resetSoeSercos 	:= UINT_TO_UDINT(mc.resetSoe.SercosErrId);

// Read Position
// Used to convert relative move to absolution move
mc.readPosition(
	Enable 			:= TRUE,
	Axis 			:= axis,
	Valid 			=>,
	Busy			=>,
	Error			=>, 
	ErrorID			=>	mc.faultId.readOffset,
	Position		=> );

saveData(
	Port 		:= 851,
	Start 		:= sts.state = E_AxisState.TeachPosition_SaveData OR savePositionListData,
	Mode 		:= SPDM_VAR_BOOST);
	
savePositionListData := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessCommands" Id="{07dc637a-4c33-4362-81a0-3d08ce54b573}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED ProcessCommands]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check for new valid commands
IF ctrl.reset THEN 
	cmdReceived := E_AxisCommand.Reset;
	ctrl.reset := FALSE;
ELSIF sts.modeManual AND ocmd <> E_AxisCommand.None THEN
	cmdReceived := ocmd;
ELSIF sts.modeAuto AND pcmd <> E_AxisCommand.None THEN
	cmdReceived := pcmd;
END_IF

// Save last commands
IF pcmd <> E_AxisCommand.None THEN
	pcmdLast := pcmd;
END_IF
IF ocmd <> E_AxisCommand.None THEN
	ocmdLast := ocmd;
END_IF
IF cmdReceived <> E_AxisCommand.None THEN
	cmdReceivedLast := cmdReceived;
END_IF

pcmd := E_AxisCommand.None;
ocmd := E_AxisCommand.None;

// Special command handling
resetErrorAndDrive := cmdReceived = E_AxisCommand.Reset;
IF cmdReceived = E_AxisCommand.Safe THEN
	PrvSafe();
END_IF
IF cmdReceived = E_AxisCommand.RelMove AND storedRelMovePosition = 0 THEN
	storedRelMovePosition := sts.position + motionParam.relMoveDistance;
END_IF
IF ftRelMove.Q THEN
	storedRelMovePosition := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrvSafe" Id="{2cb69a4c-7a96-4601-8f12-d53d3a69b3a6}" FolderPath="Protected\Commands\">
      <Declaration><![CDATA[METHOD PROTECTED PrvSafe]]></Declaration>
      <Implementation>
        <ST><![CDATA[safeDisable := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadStatus" Id="{e93bdba6-37c3-4349-9862-d5f79a6967a9}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC ReadStatus : ST_SpeedControllerStatus
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReadStatus.velocity 	:= sts.velocity;
ReadStatus.torque 		:= sts.torque;
ReadStatus.homed		:= sts.homed;
ReadStatus.coupled 		:= sts.coupled;
ReadStatus.moving 		:= sts.moving;
ReadStatus.movingFwd 	:= sts.movingFwd;
ReadStatus.movingRev 	:= sts.movingRev;
ReadStatus.faulted 		:= fault.active;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RelMove" Id="{b22754f7-56f1-4c10-a466-6a77e9974fa1}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC RelMove
VAR_INPUT
	relMoveDistance		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMotionParam(param := E_MotorMotionParam.RelMoveDistance, val := relMoveDistance);
pcmd := E_AxisCommand.RelMove;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetDoneBits" Id="{bd92918a-b3a4-449b-8de7-86851c576e2c}" FolderPath="Public\Control\">
      <Declaration><![CDATA[METHOD PUBLIC ResetDoneBits]]></Declaration>
      <Implementation>
        <ST><![CDATA[ctrlAxis.resetDoneBits := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetDrive" Id="{24ac328e-e495-4146-b02f-d00e19c082ac}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC ResetDrive // Resets drive without resetting errors]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_AxisCommand.ResetDrive;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Safe" Id="{a0b6879b-de7c-493f-ac13-ce82b3e43e69}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Safe]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Command safe regardless of mode
pcmd := E_AxisCommand.Safe;
ocmd := E_AxisCommand.Safe;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SavePosition" Id="{3f977fec-7eb6-4bcf-aa46-a53752f38660}" FolderPath="Public\Control\Positions\">
      <Declaration><![CDATA[METHOD PUBLIC SavePosition : INT
VAR_INPUT
	id : INT;
	position : LREAL;
	name : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF id >= 0 AND id <= GVL_Lib_ServoConstants.MAX_POSITIONS THEN
	positionList[id].name := name;
	positionList[id].position := position;
	SavePosition := 1; //position saved, code = 1
ELSE
	SavePosition := -1; //id out of bounds, code = -1
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMotionParam" Id="{735b0638-894b-4c38-8cdc-0b54e238dd33}" FolderPath="Public\Control\">
      <Declaration><![CDATA[METHOD PUBLIC SetMotionParam 
VAR_INPUT
	param		: E_MotorMotionParam;
	val			: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE param OF
	E_MotorMotionParam.JogSpeed:			motionParam.jogSpeed := val;
	E_MotorMotionParam.JogAccel:			motionParam.jogAccel := val;
	E_MotorMotionParam.JogDecel:			motionParam.jogDecel := val;
	E_MotorMotionParam.RelMoveDistance:		motionParam.relMoveDistance := val;
	E_MotorMotionParam.AbsMovePosition:		motionParam.absMovePosition := val;
	E_MotorMotionParam.AbsMovePositionId:	motionParam.absMovePositionId := LREAL_TO_INT(val);
	E_MotorMotionParam.ModMovePosition:		motionParam.modMovePosition := val;
	E_MotorMotionParam.MoveSpeed:			motionParam.moveSpeed := val;
	E_MotorMotionParam.MoveAccel:			motionParam.moveAccel := val;
	E_MotorMotionParam.MoveDecel:			motionParam.moveDecel := val;
	E_MotorMotionParam.Jerk:				motionParam.jerk := val;
	E_MotorMotionParam.TeachPosition:		motionParam.teachPosition := val;
	E_MotorMotionParam.HomePosition:		motionParam.homePosition := val;
	E_MotorMotionParam.HaltDecel:			motionParam.haltDecel := val;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPositionIds" Id="{5502f220-1407-4617-9c59-138c9f0add7c}" FolderPath="Public\Control\Positions\">
      <Declaration><![CDATA[METHOD INTERNAL SetPositionIds
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i :=0 TO GVL_Lib_ServoConstants.MAX_POSITIONS DO
	positionList[i].id := i;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateMachine" Id="{3bd1d427-dc6c-408e-8459-84ca0748da9b}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED StateMachine
VAR
	error: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset complete bits
IF NOT cfg.latchDoneBits OR (ctrlAxis.resetDoneBits OR resetErrorAndDrive) THEN
	ctrlAxis.resetDoneBits 		:= FALSE;

	sts.relMoveComplete			:= FALSE;
	sts.absMoveComplete			:= FALSE;
	sts.modMoveComplete			:= FALSE;
	sts.teachPositionComplete	:= FALSE;
	sts.enableLagComplete		:= FALSE;
	sts.disableLagComplete		:= FALSE;
	sts.homingComplete 			:= FALSE;
	sts.resetComplete			:= FALSE;
	sts.stopComplete 			:= FALSE;
END_IF

CASE sts.state OF
		E_AxisState.Off:
			IF sts.enable THEN
				nextState := E_AxisState.InitReadPosition;
			END_IF
			
		E_AxisState.InitReadPosition:
			IF mc.readOffset.Valid THEN
				// check if the offset is already correct
 				IF offset = mc.readOffset.Value THEN
					nextState := E_AxisState.Power;
				ELSE
					nextState := E_AxisState.InitSetPosition;
				END_IF
			END_IF
			
		E_AxisState.InitSetPosition:
			IF mc.writeOffset.Done THEN
				nextState := E_AxisState.InitEnableDelay;
			END_IF
			
		E_AxisState.InitEnableDelay:
			IF enableAxisDelay.Q THEN
				nextState := E_AxisState.Power;
			END_IF
		
		E_AxisState.Power:
			IF sts.enable AND axis.Status.Operational THEN
				nextState := E_AxisState.Enabled;
			END_IF

		E_AxisState.Enabled:
			IF sts.enable AND NOT sts.isFollower THEN				
				IF cmdReceived = E_AxisCommand.JogFwd AND sts.readyFwd THEN
					mc.MoveDirection := MC_Positive_Direction;
					nextState := E_AxisState.JogFwd_A;
				ELSIF cmdReceived = E_AxisCommand.JogRev AND sts.readyRev THEN
					mc.MoveDirection := MC_Negative_Direction;
					nextState := E_AxisState.JogRev_A;
				ELSIF cmdReceived = E_AxisCommand.LatchJogFwd AND sts.readyFwd THEN
					mc.MoveDirection := MC_Positive_Direction;
					nextState := E_AxisState.LatchJogFwd_A;
				ELSIF cmdReceived = E_AxisCommand.LatchJogRev AND sts.readyRev THEN
					mc.MoveDirection := MC_Negative_Direction;
					nextState := E_AxisState.LatchJogRev_A;
				ELSIF cmdReceived = E_AxisCommand.RelMove AND sts.readyRelMove THEN
					nextState := E_AxisState.RelMove_A;
				ELSIF cmdReceived = E_AxisCommand.AbsMove AND sts.readyAbsMove THEN
					nextState := E_AxisState.AbsMove_A;
				ELSIF cmdReceived = E_AxisCommand.ModMove AND sts.readyModMove THEN
					nextState := E_AxisState.ModMove_A;
				ELSIF cmdReceived = E_AxisCommand.TeachPositionTemp THEN
					nextState := E_AxisState.TeachPositionTemp;
				ELSIF cmdReceived = E_AxisCommand.TeachPosition THEN
					nextState := E_AxisState.TeachPosition_Read;
				ELSIF cmdReceived = E_AxisCommand.EnableLag THEN
					nextState := E_AxisState.EnableLag;
				ELSIF cmdReceived = E_AxisCommand.DisableLag THEN
					nextState := E_AxisState.DisableLag;
				ELSIF cmdReceived = E_AxisCommand.Home AND sts.readyFwd AND sts.readyRev THEN
					nextState := E_AxisState.Homing;
				ELSIF cmdReceived = E_AxisCommand.ResetDrive THEN
					nextState := E_AxisState.ResetDrive;
				ELSIF cmdReceived = E_AxisCommand.Stop THEN
					nextState := E_AxisState.Halting;
				END_IF
			END_IF
	
		E_AxisState.JogFwd_A:
			IF cmdReceived <> E_AxisCommand.JogFwd OR mc.moveVelocityA.CommandAborted THEN
				nextState := E_AxisState.Halting;
			ELSIF ftJogSpeedChanged.Q  THEN
				nextState := E_AxisState.JogFwd_B;
			END_IF
			
		E_AxisState.JogFwd_B:
			IF cmdReceived <> E_AxisCommand.JogFwd OR mc.moveVelocityB.CommandAborted THEN
				nextState :=  E_AxisState.Halting;
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.JogFwd_A;
			END_IF
			
		E_AxisState.JogRev_A:
			IF cmdReceived <> E_AxisCommand.JogRev OR mc.moveVelocityA.CommandAborted THEN
				nextState :=  E_AxisState.Halting;
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.JogRev_B;
			END_IF
			
		E_AxisState.JogRev_B:
			IF cmdReceived <> E_AxisCommand.JogRev OR mc.moveVelocityB.CommandAborted  THEN
				nextState :=  E_AxisState.Halting;
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.JogRev_A;
			END_IF	
		
		E_AxisState.LatchJogFwd_A:
			IF cmdReceived = E_AxisCommand.Stop OR mc.moveVelocityA.CommandAborted THEN
				nextState := E_AxisState.Halting;
			ELSIF cmdReceived = E_AxisCommand.LatchJogRev THEN
				IF sts.readyRev THEN
					mc.moveDirection := MC_Negative_Direction;
					nextState := E_AxisState.LatchJogRev_B;
				ELSE
					nextState := E_AxisState.Halting;
				END_IF
			ELSIF ftJogSpeedChanged.Q  THEN
				nextState := E_AxisState.LatchJogFwd_B;
			END_IF
			
		E_AxisState.LatchJogFwd_B:
			IF cmdReceived = E_AxisCommand.Stop OR mc.moveVelocityB.CommandAborted THEN
				nextState :=  E_AxisState.Halting;
			ELSIF cmdReceived = E_AxisCommand.LatchJogRev THEN
				IF sts.readyRev THEN
					mc.moveDirection := MC_Negative_Direction;
					nextState := E_AxisState.LatchJogRev_A;
				ELSE
					nextState := E_AxisState.Halting;
				END_IF
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.LatchJogFwd_A;
			END_IF
			
		E_AxisState.LatchJogRev_A:	
			IF cmdReceived = E_AxisCommand.Stop OR mc.moveVelocityA.CommandAborted THEN
				nextState :=  E_AxisState.Halting;
			ELSIF cmdReceived = E_AxisCommand.LatchJogFwd THEN
				IF sts.readyFwd THEN
					mc.moveDirection := MC_Positive_Direction;
					nextState := E_AxisState.LatchJogFwd_B;
				ELSE
					nextState := E_AxisState.Halting;
				END_IF
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.LatchJogRev_B;
			END_IF
			
		E_AxisState.LatchJogRev_B:
			IF cmdReceived = E_AxisCommand.Stop OR mc.moveVelocityB.CommandAborted  THEN
				nextState :=  E_AxisState.Halting;
			ELSIF cmdReceived = E_AxisCommand.LatchJogFwd THEN
				IF sts.readyFwd THEN
					mc.moveDirection := MC_Positive_Direction;
					nextState := E_AxisState.LatchJogFwd_A;
				ELSE
					nextState := E_AxisState.Halting;
				END_IF
			ELSIF ftJogSpeedChanged.Q THEN
				nextState := E_AxisState.LatchJogRev_A;
			END_IF
		
		E_AxisState.RelMove_A:
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.RelMove_B;
			ELSIF rtAbsMoveADone.Q OR mc.MoveAbsoluteA.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.relMoveComplete := TRUE;
			END_IF
			
		E_AxisState.RelMove_B:
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.RelMove_A;
			ELSIF rtAbsMoveBDone.Q OR mc.MoveAbsoluteB.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.relMoveComplete := TRUE;
			END_IF
			
		E_AxisState.AbsMove_A:
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.AbsMove_B;		
			ELSIF rtAbsMoveADone.Q OR mc.MoveAbsoluteA.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.absMoveComplete   := TRUE;
			END_IF
			
		E_AxisState.AbsMove_B:
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.AbsMove_A;
			ELSIF rtAbsMoveBDone.Q OR mc.moveAbsoluteB.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.absMoveComplete   := TRUE;
			END_IF
			
		E_AxisState.ModMove_A:	
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.ModMove_B;		
			ELSIF rtModMoveADone.Q OR mc.moveModuloA.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.modMoveComplete := TRUE;
			END_IF
			
		E_AxisState.ModMove_B:	
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF ftMoveSpeedChanged.Q THEN
				nextState := E_AxisState.ModMove_A;		
			ELSIF rtModMoveBDone.Q OR mc.moveModuloB.CommandAborted THEN
				nextState := E_AxisState.Enabled;
				sts.modMoveComplete := TRUE;
			END_IF
			
		E_AxisState.Halting:
			IF mc.halt.Done THEN
				nextState := E_AxisState.Enabled;
				sts.stopComplete := TRUE;
			END_IF
			
		E_AxisState.TeachPositionTemp:  
			IF mc.setPosition.Done THEN
				nextState := E_AxisState.Enabled;
				sts.teachPositionComplete := TRUE;
			END_IF
			
		E_AxisState.TeachPosition_Read: 
			// Read current offset of axis
			IF mc.readOffset.Valid THEN
				offset :=  mc.readOffset.Value + (motionParam.teachPosition - axis.NcToPlc.ActPosWithoutPosCorrection);
				nextState := E_AxisState.TeachPosition_Write;
			END_IF
			
		E_AxisState.TeachPosition_Write: 
			// Write current offset of axis
			IF mc.writeOffset.Done THEN
				nextState := E_AxisState.TeachPosition_SaveData;
			END_IF	
			
		E_AxisState.TeachPosition_SaveData: 
			// Save persistent data to maintain offsets
			IF NOT saveData.BUSY THEN
				nextState := E_AxisState.TeachPosition_EnableDelay;
			END_IF
			
		E_AxisState.TeachPosition_EnableDelay: 
			// Delay while axis is disabled
			IF enableAxisDelay.Q THEN
				nextState := E_AxisState.Power;
				sts.teachPositionComplete := TRUE;
				IF homingInProgress THEN // Indicate homing complete if position was set after homing
					sts.homingComplete := TRUE;
					homingInProgress := FALSE;
				END_IF
			END_IF
		
		E_AxisState.EnableLag:
			IF mc.enableLag.Done THEN
				nextState := E_AxisState.Enabled;
				sts.enableLagComplete	:= TRUE;
			END_IF
			
		E_AxisState.DisableLag:	
			IF mc.disableLag.Done THEN
				nextState := E_AxisState.Enabled;
				sts.disableLagComplete	:= TRUE;
			END_IF
			
		E_AxisState.Homing:	
			homingInProgress := TRUE;	
			IF cmdReceived = E_AxisCommand.Stop THEN
				nextState := E_AxisState.Halting;
			ELSIF mc.homing.Done THEN
				nextState := E_AxisState.TeachPosition_Read;
				SetMotionParam(param := E_MotorMotionParam.TeachPosition, val := axis.NcToPlc.ActPos);
			END_IF
			
		E_AxisState.ResetDrive: 
			IF mc.reset.Done THEN
				nextState := E_AxisState.Enabled;
				sts.resetComplete := TRUE;
			END_IF
			
		E_AxisState.Faulting:
			IF mc.halt.Done OR mc.halt.Error OR mc.halt.CommandAborted THEN
				nextState := E_AxisState.Faulted;
			END_IF	
			
		E_AxisState.Faulted:
			IF NOT fault.active THEN
				nextState := E_AxisState.Off;
			END_IF
END_CASE

// State Transitions from ANY State
IF NOT fault.active AND NOT sts.enable 
AND NOT (sts.state = E_AxisState.Faulting OR sts.state = E_AxisState.Faulted OR sts.state = E_AxisState.Off) THEN
	nextState := E_AxisState.Faulting;
ELSIF fault.active AND NOT (sts.state = E_AxisState.Faulting OR sts.state = E_AxisState.Faulted) THEN
	nextState := E_AxisState.Faulting;
END_IF

sts.state 	:= nextState;
cmdReceived := E_AxisCommand.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StatusIn" Id="{8eab91cb-6e01-46d1-adf2-ae25a3984f9e}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED StatusIn]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Axis
axis.ReadStatus(); // Axis status not updated cyclically, must explicitly call
sts.isFollower  := axis.Status.Coupled AND (axis.NcToPlc.CoupleState=3  OR axis.NcToPlc.CoupleState=2); // 1 - Main Motor; 2 - Follower of a Main and Main to a Follower; 3 - Follower only
sts.position	:= axis.NcToPlc.ActPos;
sts.velocity	:= axis.NcToPlc.ActVelo;
sts.torque		:= axis.NcToPlc.ActTorque;
sts.homed       := axis.Status.Homed;
sts.coupled     := axis.NcToPlc.CoupleState<>0;
sts.moving		:= axis.Status.Moving;
sts.movingFwd	:= sts.moving AND sts.velocity > 0;
sts.movingRev	:= sts.moving AND sts.velocity < 0;

sts.enable := localEnable AND NOT safeDisable
			  AND (NOT parentCtrl.estop OR NOT sts.parentConfigured);

// Permissives and Interlocks
fwdIntlk(	bypActive := sts.bypass, cfg := cfg.fwdIntlk);
fwdPerm(	bypActive := sts.bypass, cfg := cfg.fwdPerm);
revIntlk(	bypActive := sts.bypass, cfg := cfg.revIntlk);
revPerm(	bypActive := sts.bypass, cfg := cfg.revPerm);

sts.readyFwd 		:= fwdIntlk.sts.OK AND fwdPerm.sts.OK;
sts.readyRev		:= revIntlk.sts.OK AND revPerm.sts.OK;
sts.readyRelMove	:= sts.state=E_AxisState.Enabled AND
					   ((sts.readyFwd AND (motionParam.relMoveDistance >= 0)) 
					 OR (sts.readyRev AND (motionParam.relMoveDistance <= 0)));
sts.readyAbsMove	:= sts.state=E_AxisState.Enabled AND
					   ((sts.readyFwd AND (motionParam.absMovePosition >= sts.position)) 
					 OR (sts.readyRev AND (motionParam.absMovePosition <= sts.position))); 
sts.readyModMove	:= sts.state=E_AxisState.Enabled AND
					   ((sts.readyFwd AND (motionParam.modMovePosition >= sts.position))  
					 OR (sts.readyRev AND (motionParam.modMovePosition <= sts.position)));

IF sts.moving AND ((NOT fwdIntlk.sts.OK AND sts.movingFwd) OR (NOT revIntlk.sts.OK AND sts.movingRev))
THEN
	PrvSafe();
END_IF

// Timers
enableAxisDelay(IN := sts.state = E_AxisState.InitEnableDelay OR sts.state = E_AxisState.TeachPosition_EnableDelay, PT := cfg.tEnableAxisDelay);

// Check for Speed Change
jogSpeedChanged 			:= motionParam.jogSpeed <> jogSpeedLast;
jogSpeedLast 				:= motionParam.jogSpeed;
ftJogSpeedChanged(CLK		:= jogSpeedChanged);
moveSpeedChanged 			:= motionParam.MoveSpeed <> moveSpeedLast;
moveSpeedLast 				:= motionParam.MoveSpeed;
ftMoveSpeedChanged(CLK		:= moveSpeedChanged);

// Other triggers
ftRelMove(CLK := sts.state = E_AxisState.RelMove_A OR sts.state = E_AxisState.RelMove_B);
rtAbsMoveADone(CLK := mc.moveAbsoluteA.Done);
rtAbsMoveBDone(CLK := mc.moveAbsoluteB.Done);
rtModMoveADone(CLK := mc.moveModuloA.Done);
rtModMoveBDone(CLK := mc.moveModuloB.Done);]]></ST>
      </Implementation>
    </Method>
    <Method Name="StatusOut" Id="{63df2102-2ea4-4257-934e-3f5fd2a0894c}" FolderPath="Protected\Logic\">
      <Declaration><![CDATA[METHOD PROTECTED StatusOut]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Report Command Statuses
sts.jogFwdInProgress 	:= (sts.state = E_AxisState.JogFwd_A 		OR sts.state = E_AxisState.JogFwd_B)
						OR (sts.state = E_AxisState.LatchJogFwd_A 	OR sts.state = E_AxisState.LatchJogFwd_B);
sts.jogRevInProgress 	:= (sts.state = E_AxisState.JogRev_A 		OR sts.state = E_AxisState.JogRev_B)
						OR (sts.state = E_AxisState.LatchJogRev_A	OR sts.state = E_AxisState.LatchJogRev_B);
sts.jogAtSpeed			:= mc.MoveVelocityA.InVelocity OR mc.MoveVelocityB.InVelocity;
sts.relMoveInProgress 	:= (sts.state = E_AxisState.RelMove_A OR sts.state = E_AxisState.RelMove_B);
sts.absMoveInProgress 	:= (sts.state = E_AxisState.AbsMove_A OR sts.state = E_AxisState.AbsMove_B);
sts.modMoveInProgress 	:= (sts.state = E_AxisState.ModMove_A OR sts.state = E_AxisState.ModMove_B);

// Other
sts.driveDiagnosticNumber := driveDiagnosticNumber;
ctrlAxis.resetDoneBits := FALSE;
lastFaultId := fault.id;
IF sts.state < E_AxisState.Faulting THEN
	lastGoodState := sts.state;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{7e754a9b-94b8-4719-9b10-9f136a1d6dcf}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Stop]]></Declaration>
      <Implementation>
        <ST><![CDATA[pcmd := E_AxisCommand.Stop;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TeachPosition" Id="{691c5ae2-e507-413f-98ba-e65c7c966668}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC TeachPosition
VAR_INPUT
	position 		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetMotionParam(param := E_MotorMotionParam.TeachPosition, val := position);
pcmd := E_AxisCommand.TeachPosition;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TeachPositionTemp" Id="{f26129b8-a397-4db8-8e96-27cebcd66506}" FolderPath="Public\Commands\">
      <Declaration><![CDATA[METHOD PUBLIC TeachPositionTemp
