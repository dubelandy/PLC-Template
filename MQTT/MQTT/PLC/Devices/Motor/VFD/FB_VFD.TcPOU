<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_VFD" Id="{0d1cf585-a757-4cd5-89df-c3d934be6e22}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'reflection'}
FUNCTION_BLOCK FB_VFD
VAR_INPUT
	parentCtrl			: ST_ParentChildControl;
	
	{attribute 'OPC.UA.DA' := '1'}
	ocmd 				: E_VFDCommand; 
	
	//Interlocks and permissives
	fwdIntlk			: FB_Permissive; 
	fwdPerm				: FB_Permissive; 
	revIntlk			: FB_Permissive; 
	revPerm				: FB_Permissive; 

	inStatusWord 	AT %I* 	: WORD; 
	inControlEffort	AT %I* 	: WORD; 
	
	{attribute 'OPC.UA.DA' := '1'}
	ctrl 	: ST_Actuator2StateControl;
	{attribute 'OPC.UA.DA' := '1'}
	cfg 	: ST_VFDConfiguration;
	
	func	: ST_VFDFunctions;
	
	cmdQuickStop : BOOL;
END_VAR
VAR_OUTPUT
	outControlWord 		AT %Q* : WORD; 
	outTargetVelocity  	AT %Q* : WORD; 

	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}//read only
	sts					: ST_VFDStatus; //status

	{attribute 'instance-path'}
	{attribute 'no-init'}
	instancePath		: T_MaxString;
END_VAR
VAR
	// Command vars
	pcmd			: E_VFDCommand;
	pcmdLast		: E_VFDCommand;
	ocmdLast		: E_VFDCommand;	
	activeCommand	: E_VFDCommand;
	activeCmdLast	: E_VFDCommand;
	
	// State vars
	stCommands		: ST_VFDCommand;
	maskState		: WORD := LOWEST_8_BITS;
	arrNotReady		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	arrRunning		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	arrReady		: ARRAY[1..MAX_ARR_LENGTH] OF WORD;
	
	// Debugging 
	statusWord_CiA402 : ST_CiA402StatusWord;
	
	// General
	rtManualOvrde	: R_TRIG;
	opActivity		: BOOL;
	manualOvrdeTimer: TON;
	firstEnable		: BOOL;
END_VAR
VAR CONSTANT
	LOWEST_4_BITS	: WORD := 2#000000001111;
	LOWEST_8_BITS	: WORD := 2#000011111111;
	LOWEST_12_BITS	: WORD := 2#111111111111;
	MAX_ARR_LENGTH	: INT  := 10;
	
	// Constants specific to the CiA402 functional profile
	FAULTED_BIT			: INT := 3;
	DISABLED_BIT		: INT := 6;
	TARGET_REACHED_BIT	: INT := 10;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[ModeControl();
MapInputs();
ProcessCommands();
StateMachine();
Status();
MapOutputs();
Functions();]]></ST>
    </Implementation>
