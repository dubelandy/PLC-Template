    <Method Name="MapInputs" Id="{1d37a052-66c8-495f-b5ef-194541fad662}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED MapInputs : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//***********************************************************//
//				   Permissives & Interlocks					 //
//***********************************************************//
fwdPerm(	bypActive := sts.bypass, cfg := cfg.fwdPerm);
fwdIntlk(	bypActive := sts.bypass, cfg := cfg.fwdIntlk);
revPerm(	bypActive := sts.bypass, cfg := cfg.revPerm);
revIntlk(	bypActive := sts.bypass, cfg := cfg.revIntlk);

//***********************************************************//
//		     	 Command & State Assignments				 //
//***********************************************************//
// Assign binary numbers to VFD commands and VFD states based on configured profile

// Clear state arrays in preparation for assignment
FOR i := 1 TO MAX_ARR_LENGTH DO
	arrNotReady[i] 	:= 0;
	arrReady[i] 	:= 0;
	arrRunning[i] 	:= 0;
END_FOR

// Clear statusWord_CiA402 in case we're no longer using it
statusWord_CiA402.ReadyToSwitch 	  := FALSE;
statusWord_CiA402.SwitchedOn 		  := FALSE;
statusWord_CiA402.OpEnabled 		  := FALSE;
statusWord_CiA402.Fault 			  := FALSE;
statusWord_CiA402.VoltageEnabled 	  := FALSE;
statusWord_CiA402.QuickStopDisengaged := FALSE;
statusWord_CiA402.SwitchOnDisabled    := FALSE;
statusWord_CiA402.Warning 			  := FALSE;
statusWord_CiA402.Reserved8 		  := FALSE;
statusWord_CiA402.Remote 			  := FALSE;
statusWord_CiA402.TargetReached 	  := FALSE;
statusWord_CiA402.LimitExceeded 	  := FALSE;
statusWord_CiA402.Reserved12 		  := FALSE;
statusWord_CiA402.Reserved13 		  := FALSE;
statusWord_CiA402.StopKey 			  := FALSE;
statusWord_CiA402.Direction			  := FALSE;

// Assign
IF (cfg.profile = E_FunctionalProfile.CiA402) THEN
	
	// Build commands 
	stCommands.Enable    := 2#000000000110; // Set: Enable Voltage, QuickStopDisengage   							
	stCommands.JogFwd    := 2#000000001111; // Set: SwitchOn, Enable Voltage, QuickStopDisengage, EnableOp
	stCommands.JogRev	 := 2#100000001111;	// Set: SwitchOn, Enable Voltage, QuickStopDisengage, EnableOp, Direction
	stCommands.QuickStop := 2#000000000010; // Set: Enable Voltage
	stCommands.Reset	 := 2#000010000000;	// Set: Fault Reset
	stCommands.Stop 	 := 2#000000000111; // Set: SwitchOn, Enable Voltage, QuickStopDisengage
	
	// Build an array of acceptable status words per state
	maskState 	:= LOWEST_8_BITS;
	arrNotReady[1] := 2#01000000; // SwitchOnDisabled - 16#xx40
	arrNotReady[2] := 2#01010000; // SwitchOnDisabled - 16#xx50
	arrNotReady[3] := 2#00010111; // QuickStopActive
	arrReady[1]    := 2#00100001; // ReadyToSwitchOn - 16#xx21
	arrReady[2]    := 2#00110001; // ReadyToSwitchOn - 16#xx31
	arrReady[3]    := 2#00110011; // SwitchedOn
	arrRunning[1]  := 2#00110111; // OperationEnabled
	
	// Update other vars that are based on this profile
	sts.faulted := inStatusWord.FAULTED_BIT;
	sts.enabled := NOT inStatusWord.DISABLED_BIT;
	sts.atSpeed := inStatusWord.TARGET_REACHED_BIT;
							
	// For easy debugging - map status word to a struct of bits 
	statusWord_CiA402.ReadyToSwitch 	  := inStatusWord.0;
	statusWord_CiA402.SwitchedOn 		  := inStatusWord.1;
	statusWord_CiA402.OpEnabled 		  := inStatusWord.2;
	statusWord_CiA402.Fault 			  := inStatusWord.3;
	statusWord_CiA402.VoltageEnabled 	  := inStatusWord.4;
	statusWord_CiA402.QuickStopDisengaged := inStatusWord.5;
	statusWord_CiA402.SwitchOnDisabled    := inStatusWord.6;
	statusWord_CiA402.Warning 			  := inStatusWord.7;
	statusWord_CiA402.Reserved8 		  := inStatusWord.8;
	statusWord_CiA402.Remote 			  := inStatusWord.9;
	statusWord_CiA402.TargetReached 	  := inStatusWord.10;
	statusWord_CiA402.LimitExceeded 	  := inStatusWord.11;
	statusWord_CiA402.Reserved12 		  := inStatusWord.12;
	statusWord_CiA402.Reserved13 		  := inStatusWord.13;
	statusWord_CiA402.StopKey 			  := inStatusWord.14;
	statusWord_CiA402.Direction			  := inStatusWord.15;
	
ELSIF (cfg.profile = E_FunctionalProfile.SchneiderIO) THEN
	
	// Build commands 
	stCommands.Enable    := 2#000000000000;   							
	stCommands.JogFwd    := 2#000000000001; 
	stCommands.JogRev	 := 2#000000000101;	
	stCommands.QuickStop := 2#000000000000;
	stCommands.Reset	 := 2#000000000010;	
	stCommands.Stop 	 := 2#000000000000; 
	
	// Build an array of acceptable status words per state
	maskState 	:= LOWEST_8_BITS;
	arrNotReady[1] := 2#01000000; // SwitchOnDisabled - 16#xx40
	arrNotReady[2] := 2#01010000; // SwitchOnDisabled - 16#xx50
	arrNotReady[3] := 2#00010111; // QuickStopActive
	arrReady[1]    := 2#00100001; // ReadyToSwitchOn - 16#xx21
	arrReady[2]    := 2#00110001; // ReadyToSwitchOn - 16#xx31
	arrReady[3]    := 2#00110011; // SwitchedOn
	arrRunning[1]  := 2#00110111; // OperationEnabled
	
	// Update other vars that are based on this profile
	sts.faulted := inStatusWord.FAULTED_BIT;
	sts.enabled := NOT inStatusWord.DISABLED_BIT;
	sts.atSpeed := inStatusWord.TARGET_REACHED_BIT;
							
	// For easy debugging - map status word to a struct of bits 
	statusWord_CiA402.ReadyToSwitch 	  := inStatusWord.0;
	statusWord_CiA402.SwitchedOn 		  := inStatusWord.1;
	statusWord_CiA402.OpEnabled 		  := inStatusWord.2;
	statusWord_CiA402.Fault 			  := inStatusWord.3;
	statusWord_CiA402.VoltageEnabled 	  := inStatusWord.4;
	statusWord_CiA402.QuickStopDisengaged := inStatusWord.5;
	statusWord_CiA402.SwitchOnDisabled    := inStatusWord.6;
	statusWord_CiA402.Warning 			  := inStatusWord.7;
	statusWord_CiA402.Reserved8 		  := inStatusWord.8;
	statusWord_CiA402.Remote 			  := inStatusWord.9;
	statusWord_CiA402.TargetReached 	  := inStatusWord.10;
	statusWord_CiA402.LimitExceeded 	  := inStatusWord.11;
	statusWord_CiA402.Reserved12 		  := inStatusWord.12;
	statusWord_CiA402.Reserved13 		  := inStatusWord.13;
	statusWord_CiA402.StopKey 			  := inStatusWord.14;
	statusWord_CiA402.Direction			  := inStatusWord.15;
ELSE
	;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapOutputs" Id="{643d0eb7-ae24-4e8d-a0b3-12528c319093}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED MapOutputs : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (sts.movingFwd AND NOT fwdIntlk.sts.ok) OR (sts.movingRev AND NOT revIntlk.sts.ok) THEN
	activeCommand 		:= E_VFDCommand.Stop;
	sts.error.error 	:= TRUE;
	sts.error.message 	:= 'Interlocks were dropped';
END_IF

CASE activeCommand OF
	E_VFDCommand.None:
		;
		
	E_VFDCommand.Stop:
		IF cmdQuickStop THEN
			outControlWord	:= stCommands.QuickStop;
		ELSE
			outControlWord  := stCommands.Stop;
		END_IF
		
	E_VFDCommand.Enable:
		firstEnable := TRUE;
		IF NOT sts.state_running THEN
			outControlWord  := stCommands.Enable;
		END_IF
		
	E_VFDCommand.JogFwd, E_VFDCommand.LatchJogFwd:
		IF sts.ReadyFwd THEN
			outControlWord 	:= stCommands.JogFwd;
		ELSE
			sts.error.error := TRUE;
			IF NOT fwdIntlk.sts.ok OR NOT fwdPerm.sts.ok THEN
				sts.error.message := 'Check perms and interlocks';
			ELSE
				sts.error.message := 'Command is invalid for current drive state';
			END_IF
		END_IF
		
	E_VFDCommand.JogRev, E_VFDCommand.LatchJogRev:
		IF sts.ReadyRev THEN
			outControlWord 	:= stCommands.JogRev;
		ELSE
			sts.error.error := TRUE;
			IF NOT revIntlk.sts.ok OR NOT revPerm.sts.ok THEN
				sts.error.message := 'Check perms and interlocks';
			ELSE
				sts.error.message := 'Command is invalid for current drive state';
			END_IF
		END_IF
		
	E_VFDCommand.Reset:
		sts.error.error 	:= FALSE;
		sts.error.message 	:= '';
		outControlWord 		:= stCommands.Reset;

END_CASE

IF NOT sts.sim THEN
	outTargetVelocity := cfg.targetVelocity;
ELSE
	outTargetVelocity := 0;
END_IF

// Clear variables before next cycle
activeCommand	:= E_VFDCommand.None;
cmdQuickStop 	:= FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ModeControl" Id="{0286e2d1-0c0c-4395-859d-b0148e6b1bb8}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED ModeControl : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check if parent is configured
sts.parentConfigured := parentCtrl.instancePath <> '';

// Manual override logic
opActivity := ocmd <> E_VFDCommand.None;
manualOvrdeTimer(IN := ctrl.manualOvrde AND NOT opActivity,
		   		PT := cfg.opTimeout);
IF manualOvrdeTimer.Q AND cfg.opTimeoutEnable THEN
	ctrl.manualOvrde := FALSE;
END_IF

// Determine device mode
CASE sts.mode OF
	E_SystemMode.Idle:
		sts.mode := E_SystemMode.Auto;
	E_SystemMode.Auto:											
		IF ctrl.manualOvrde															
		OR (sts.parentConfigured AND parentCtrl.mode <> E_SystemMode.Auto)
		THEN	
			sts.mode := E_SystemMode.Manual;
		END_IF
	E_SystemMode.Manual:					
		IF NOT ctrl.manualOvrde 			
		AND (NOT sts.parentConfigured OR parentCtrl.mode = E_SystemMode.Auto)
		THEN
			sts.mode := E_SystemMode.Auto;
		END_IF
	ELSE
		sts.mode := E_SystemMode.Idle;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessCommands" Id="{0c639938-bc05-4faa-a6c5-5abbd3ebab96}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED ProcessCommands : BOOL
VAR_INPUT
END_VAR

// Check for new valid command]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check for reset command
IF ctrl.reset THEN 
	activeCommand := E_VFDCommand.Reset;
	ctrl.reset := FALSE;
	
// Check for a special quick stop command (not available through HMI). This can be 
// used for emergency stops if freewheel stop is not enough.
ELSIF cmdQuickStop THEN
	activeCommand := E_VFDCommand.Stop;

// Else go through our typical manual vs. auto command checks
ELSIF sts.modeManual AND ocmd <> E_VFDCommand.None AND NOT (parentCtrl.estop AND sts.parentConfigured) THEN
	activeCommand := ocmd;
ELSIF sts.modeAuto AND pcmd <> E_VFDCommand.None THEN
	activeCommand := pcmd;

// Lastly, the following logic is added to preserve similar behavior to FB_Servo
ELSIF (activeCmdLast = E_VFDCommand.JogFwd) OR (activeCmdLast = E_VFDCommand.JogRev) THEN
	activeCommand := E_VFDCommand.Stop;
ELSIF (activeCmdLast = E_VFDCommand.Reset) AND firstEnable THEN
	activeCommand := E_VFDCommand.Enable;
END_IF

// Store last commands for next cycle
IF pcmd <> E_VFDCommand.None THEN
	pcmdLast := pcmd;
END_IF
IF ocmd <> E_VFDCommand.None THEN
	ocmdLast := ocmd;
END_IF
IF activeCommand <> E_VFDCommand.None THEN
	activeCmdLast := activeCommand;
END_IF

pcmd := E_VFDCommand.None;
ocmd := E_VFDCommand.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{03d1689d-635a-4e94-b388-2c9b83888cde}" FolderPath="Public\Control\">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ctrl.reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateMachine" Id="{bb5e6aa9-3ce3-4b82-a792-612d596e1bbd}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD StateMachine : BOOL
VAR_INPUT
END_VAR
VAR
	i : INT;
END_VAR

// NOTE : This is purely for information purposes. It is checking the actual state of the VFD
// by interpreting the status word. It is intended mostly for debugging.]]></Declaration>
      <Implementation>
        <ST><![CDATA[sts.state := E_VFDState.Unknown;

// This is very hacky
FOR i := 1 TO MAX_ARR_LENGTH DO
	IF (inStatusWord AND maskState) = arrRunning[i] THEN
		sts.state := E_VFDState.Running;

	ELSIF (inStatusWord AND maskState) = arrNotReady[i] OR sts.faulted THEN
		sts.state := E_VFDState.NotReady;
		
	ELSIF (inStatusWord AND maskState) = arrReady[i] THEN
		sts.state := E_VFDState.Ready;
	END_IF
	
	IF sts.state <> E_VFDState.Unknown THEN
		i := MAX_ARR_LENGTH;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Status" Id="{fa1ff35f-32a7-48b6-a906-081784bd4c29}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED Status : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// state flags
sts.state_notReady  := (sts.state = E_VFDState.NotReady);
sts.state_ready 	:= (sts.state = E_VFDState.Ready);
sts.state_running	:= (sts.state = E_VFDState.Running);

// general flags
sts.modeAuto 	:= sts.mode = E_SystemMode.Auto;
sts.modeManual 	:= sts.mode = E_SystemMode.Manual;

sts.manualOvrde := ctrl.manualOvrde;
sts.bypass 		:= ctrl.bypass;
sts.sim 		:= ctrl.sim;

sts.moving 		  := sts.state_running AND (outTargetVelocity > 0);
sts.movingFwd	  := sts.moving AND (outControlWord = stCommands.JogFwd); // Better to check status word but I don't want even more bit configuration
sts.movingRev	  := sts.moving AND (outControlWord = stCommands.JogRev);

sts.readyFwd 	:= fwdPerm.sts.ok AND fwdIntlk.sts.ok AND (sts.state_ready OR sts.state_running);
sts.readyRev 	:= revPerm.sts.ok AND revIntlk.sts.ok AND (sts.state_ready OR sts.state_running);

// error flags
IF sts.faulted THEN
	sts.error.error 	:= TRUE;
	sts.error.message 	:= 'Drive is in faulted state';
END_IF]]></ST>
      </Implementation>
    </Method>
