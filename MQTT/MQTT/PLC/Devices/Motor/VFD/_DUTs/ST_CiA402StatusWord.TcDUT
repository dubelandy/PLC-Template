<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CiA402StatusWord" Id="{208120cb-c11b-402e-a674-73373b201253}">
    <Declaration><![CDATA[TYPE ST_CiA402StatusWord :
STRUCT
	ReadyToSwitch  		: BIT;
	SwitchedOn 			: BIT;
	OpEnabled 			: BIT; 
	Fault				: BIT;
	VoltageEnabled		: BIT;
	QuickStopDisengaged	: BIT; // 0 = quickstop on, 1 = quickstop off
	SwitchOnDisabled	: BIT;
	Warning				: BIT;
	Reserved8			: BIT;
	Remote				: BIT;
	TargetReached		: BIT; // 0 = fwd, 1 = rev
	LimitExceeded		: BIT;
	Reserved12			: BIT;
	Reserved13			: BIT;
	StopKey				: BIT;
	Direction			: BIT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>